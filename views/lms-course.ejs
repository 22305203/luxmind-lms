<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= course.code %> | <%= t.portal_title %></title>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800&family=Manrope:wght@500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
  <style>
    :root {
      --navy: #111d35; --page: #f4f6fa; --surface: #fff; --text: #172238; --muted: #718096;
      --line: #e6ebf2; --blue: #3867e8; --blue-soft: #edf2ff; --green: #15966b; --green-soft: #e9f8f1;
      --shadow: 0 8px 28px rgba(24, 39, 75, .055); --radius: 16px;
    }
    * { box-sizing: border-box; }
    body { margin: 0; min-height: 100vh; background: var(--page); color: var(--text); font-family: "DM Sans", sans-serif; }
    a { color: inherit; text-decoration: none; }

    /* Top Navbar */
    .topbar { background: var(--surface); border-bottom: 1px solid var(--line); padding: 16px 40px; display: flex; justify-content: space-between; align-items: center; position: sticky; top: 0; z-index: 100; }
    .brand { display: flex; align-items: center; gap: 12px; }
    .brand-mark { width: 40px; height: 40px; display: grid; place-items: center; border-radius: 10px; color: #fff; font-size: 16px; background: linear-gradient(135deg, #527df2, #3157cb); }
    .brand-name { color: var(--navy); font: 800 18px "Manrope", sans-serif; }
    .nav-right { display: flex; align-items: center; gap: 20px; }
    .lang-select { padding: 6px 10px; border-radius: 8px; border: 1px solid var(--line); background: #f4f6fa; color: var(--navy); font-weight: 600; font-size: 13px; outline: none; cursor: pointer; }
    .user-menu { display: flex; align-items: center; gap: 10px; font-size: 14px; font-weight: 600; color: var(--navy); }

    /* Layout */
    .container { max-width: 1400px; margin: 0 auto; padding: 32px 20px; display: grid; grid-template-columns: 260px 1fr 280px; gap: 24px; }
    
    /* Left Sidebar */
    .course-nav { background: var(--surface); border-radius: var(--radius); box-shadow: var(--shadow); border: 1px solid var(--line); overflow: hidden; height: fit-content; }
    .course-header-side { background: linear-gradient(135deg, var(--navy), #1c3155); padding: 24px; color: white; }
    .course-code-side { display: inline-block; padding: 4px 8px; background: rgba(255,255,255,0.15); border-radius: 6px; font-size: 11px; font-weight: 800; margin-bottom: 12px; }
    .course-header-side h2 { margin: 0; font: 800 20px "Manrope", sans-serif; }
    .nav-list { list-style: none; padding: 12px; margin: 0; display: flex; flex-direction: column; gap: 4px; }
    .nav-list a { display: flex; align-items: center; gap: 12px; font-size: 14px; font-weight: 600; color: #4c5a70; padding: 12px 16px; border-radius: 8px; transition: 0.2s; }
    .nav-list a:hover, .nav-list a.active { background: var(--blue-soft); color: var(--blue); }
    .nav-list i { width: 20px; text-align: center; font-size: 16px; }

    /* Main Content Area */
    .main-content { background: var(--surface); border-radius: var(--radius); box-shadow: var(--shadow); border: 1px solid var(--line); padding: 32px; }
    .section-title { font: 800 24px "Manrope", sans-serif; color: #142039; margin: 0 0 24px 0; border-bottom: 2px solid var(--line); padding-bottom: 16px; }
    
    .item-card { border: 1px solid var(--line); border-radius: 12px; padding: 20px; margin-bottom: 16px; display: flex; justify-content: space-between; align-items: center; transition: 0.2s; background: #fafbfe; }
    .item-card:hover { border-color: var(--blue); background: #fff; box-shadow: 0 4px 12px rgba(56,103,232,0.05); }
    .item-info h4 { margin: 0 0 6px; font-size: 16px; color: #142039; }
    .item-meta { font-size: 13px; color: var(--muted); display: flex; gap: 16px; align-items: center; }
    
    .btn { padding: 10px 18px; background: var(--blue); color: white; border-radius: 8px; font-size: 13px; font-weight: 700; border: none; cursor: pointer; display: inline-flex; align-items: center; gap: 8px; transition: 0.2s; }
    .btn:hover { background: #2a53c9; }
    .btn-green { background: var(--green); }
    .btn-green:hover { background: #0f7d57; }

    /* Right Sidebar */
    .right-sidebar { display: flex; flex-direction: column; gap: 24px; }
    .widget { background: var(--surface); border-radius: var(--radius); box-shadow: var(--shadow); border: 1px solid var(--line); padding: 24px; }
    .widget h3 { margin: 0 0 16px; font: 800 16px "Manrope", sans-serif; color: var(--navy); }
    .widget p { font-size: 14px; color: var(--muted); margin: 0 0 12px; display: flex; align-items: center; gap: 10px; }

    @media (max-width: 1100px) {
      .container { grid-template-columns: 260px 1fr; }
      .right-sidebar { display: none; }
    }
    @media (max-width: 800px) {
      .container { grid-template-columns: 1fr; }
      .course-nav { display: flex; overflow-x: auto; }
      .course-header-side { display: none; }
      .nav-list { flex-direction: row; padding: 8px; }
      .nav-list a { white-space: nowrap; }
    }
  </style>
</head>
<body>
  <header class="topbar">
    <div class="brand">
      <div class="brand-mark"><i class="fa-solid fa-book-open"></i></div>
      <div class="brand-name"><%= t.portal_title %></div>
    </div>
    <div class="nav-right">
      <!-- LANGUAGE SWITCHER IS NOW HERE TOO -->
      <select class="lang-select" onchange="window.location.href='/set-language/'+this.value">
        <option value="en" <%= lang === 'en' ? 'selected' : '' %>>🇬🇧 English</option>
        <option value="fr" <%= lang === 'fr' ? 'selected' : '' %>>🇫🇷 Français</option>
        <option value="rn" <%= lang === 'rn' ? 'selected' : '' %>>🇧🇮 Kirundi</option>
        <option value="sw" <%= lang === 'sw' ? 'selected' : '' %>>🇹🇿 Kiswahili</option>
      </select>

      <div class="user-menu">
        <span><%= user.full_name %></span>
        <a href="/logout" style="color:#d34d5b; margin-left:10px;" title="<%= t.nav.logout %>"><i class="fa-solid fa-arrow-right-from-bracket"></i></a>
      </div>
    </div>
  </header>

  <div class="container">
    <!-- Left Sidebar (Course Navigation) -->
    <aside class="course-nav">
      <div class="course-header-side">
        <span class="course-code-side"><%= course.code %></span>
        <h2><%= course.title %></h2>
      </div>
      <ul class="nav-list">
        <li><a href="/course/<%= course.id %>?view=dashboard" class="<%= view === 'dashboard' ? 'active' : '' %>"><i class="fa-solid fa-house"></i> <%= t.course.home %></a></li>
        <li><a href="/course/<%= course.id %>?view=announcements" class="<%= view === 'announcements' ? 'active' : '' %>"><i class="fa-solid fa-bullhorn"></i> <%= t.course.announcements %></a></li>
        <li><a href="/course/<%= course.id %>?view=syllabus" class="<%= view === 'syllabus' ? 'active' : '' %>"><i class="fa-solid fa-file-contract"></i> <%= t.course.syllabus %></a></li>
        <li><a href="/course/<%= course.id %>?view=materials" class="<%= view === 'materials' ? 'active' : '' %>"><i class="fa-solid fa-folder-open"></i> <%= t.course.materials %></a></li>
        <li><a href="/course/<%= course.id %>?view=assignments" class="<%= view === 'assignments' ? 'active' : '' %>"><i class="fa-solid fa-file-pen"></i> <%= t.course.assignments %></a></li>
        <li><a href="/course/<%= course.id %>?view=quizzes" class="<%= view === 'quizzes' ? 'active' : '' %>"><i class="fa-solid fa-stopwatch"></i> <%= t.course.quizzes %></a></li>
        <li><a href="/course/<%= course.id %>?view=forums" class="<%= view === 'forums' ? 'active' : '' %>"><i class="fa-solid fa-comments"></i> <%= t.course.forums %></a></li>
        <li><a href="/course/<%= course.id %>?view=grades" class="<%= view === 'grades' ? 'active' : '' %>"><i class="fa-solid fa-chart-simple"></i> <%= t.course.grades %></a></li>
        <li><a href="/course/<%= course.id %>?view=attendance" class="<%= view === 'attendance' ? 'active' : '' %>"><i class="fa-solid fa-calendar-check"></i> <%= t.course.attendance %></a></li>
        <li><a href="/course/<%= course.id %>?view=evaluation" class="<%= view === 'evaluation' ? 'active' : '' %>"><i class="fa-solid fa-star"></i> <%= t.course.evaluation %></a></li>
      </ul>
    </aside>

    <!-- Middle Content Area -->
    <main class="main-content">
      
      <!-- DASHBOARD VIEW -->
      <% if (view === 'dashboard') { %>
        <h1 class="section-title"><%= t.course.home %>: <%= course.title %></h1>
        <p style="color: var(--muted); font-size: 15px; line-height: 1.6;">Select a topic from the left sidebar to view your assignments, notes, or grades.</p>
      <% } %>

      <!-- ANNOUNCEMENTS VIEW -->
      <% if (view === 'announcements') { %>
        <h1 class="section-title"><%= t.course.announcements %></h1>
        <% if (announcements.length === 0) { %>
          <p style="color: var(--muted);"><%= t.dash.no_ann %></p>
        <% } else { %>
          <% announcements.forEach(a => { %>
            <div class="item-card" style="display: block;">
              <h4><%= a.title %></h4>
              <p style="color: var(--muted); margin: 8px 0 0; font-size:14px; line-height:1.6;"><%= a.message %></p>
            </div>
          <% }); %>
        <% } %>
      <% } %>

      <!-- ASSIGNMENTS VIEW -->
      <% if (view === 'assignments' || view === 'dashboard') { %>
        <h1 class="section-title"><%= t.course.assignments %></h1>
        <% if (assignments.length === 0) { %>
          <p style="color: var(--muted);"><%= t.course.no_assign %></p>
        <% } else { %>
          <% assignments.forEach(a => { %>
            <div class="item-card">
              <div class="item-info">
                <h4><%= a.title %></h4>
                <div class="item-meta">
                  <span><i class="fa-regular fa-clock"></i> <%= t.course.due %>: <%= new Date(a.due_date).toLocaleDateString() %></span>
                  <span><i class="fa-solid fa-star"></i> <%= a.max_points %> <%= t.course.points %></span>
                </div>
              </div>
              <button class="btn"><i class="fa-solid fa-upload"></i> <%= t.course.submit %></button>
            </div>
          <% }); %>
        <% } %>
      <% } %>

      <!-- QUIZZES VIEW -->
      <% if (view === 'quizzes') { %>
        <h1 class="section-title"><%= t.course.quizzes %></h1>
        <% if (quizzes.length === 0) { %>
          <p style="color: var(--muted);">No quizzes available right now.</p>
        <% } else { %>
          <% quizzes.forEach(q => { %>
            <div class="item-card">
              <div class="item-info">
                <h4><%= q.title %></h4>
                <div class="item-meta">
                  <span><i class="fa-regular fa-clock"></i> <%= t.course.time_limit %>: <%= q.time_limit_minutes %> mins</span>
                </div>
              </div>
              <button class="btn"><i class="fa-solid fa-play"></i> <%= t.course.start %></button>
            </div>
          <% }); %>
        <% } %>
      <% } %>

      <!-- COURSE MATERIALS (NOTES) VIEW -->
      <% if (view === 'materials') { %>
        <h1 class="section-title"><%= t.course.materials %></h1>
        <% if (materials.length === 0) { %>
          <p style="color: var(--muted);"><%= t.course.no_mat %></p>
        <% } else { %>
          <% materials.forEach(m => { %>
            <div class="item-card">
              <div class="item-info">
                <h4><%= m.title %></h4>
                <div class="item-meta">
                  <span><i class="fa-solid fa-calendar"></i> Week <%= m.week_number %></span>
                </div>
              </div>
              <a href="<%= m.file_url %>" target="_blank" class="btn btn-green"><i class="fa-solid fa-download"></i> <%= t.course.view %></a>
            </div>
          <% }); %>
        <% } %>
      <% } %>

      <!-- GRADES VIEW -->
      <% if (view === 'grades') { %>
        <h1 class="section-title"><%= t.course.grades %></h1>
        <% if (grades.length === 0) { %>
          <p style="color: var(--muted);">No grades published yet.</p>
        <% } else { %>
          <% grades.forEach(g => { %>
            <div class="item-card">
              <div class="item-info">
                <h4><%= g.title %></h4>
              </div>
              <div style="font-weight: 800; color: var(--blue); font-size: 18px;">
                <%= g.grade %> / <%= g.max_points %>
              </div>
            </div>
          <% }); %>
        <% } %>
      <% } %>

      <!-- SYLLABUS VIEW -->
      <% if (view === 'syllabus') { %>
        <h1 class="section-title"><%= t.course.syllabus %></h1>
        <div class="item-card" style="display:block; padding: 40px; text-align: center;">
          <i class="fa-solid fa-file-pdf" style="font-size: 40px; color: var(--muted); margin-bottom: 16px;"></i>
          <h3 style="margin: 0 0 8px;">Syllabus PDF</h3>
          <p style="color: var(--muted); margin-bottom: 20px;">The instructor has not uploaded the syllabus yet.</p>
        </div>
      <% } %>

      <!-- OTHER PLACEHOLDERS -->
      <% if (view === 'forums' || view === 'attendance' || view === 'evaluation') { %>
        <h1 class="section-title"><%= t.course[view] %></h1>
        <div class="item-card" style="display:block; padding: 40px; text-align: center;">
          <i class="fa-solid fa-person-digging" style="font-size: 40px; color: var(--muted); margin-bottom: 16px;"></i>
          <h3 style="margin: 0 0 8px;">Coming Soon</h3>
          <p style="color: var(--muted);">This feature will be available shortly.</p>
        </div>
      <% } %>

    </main>

    <!-- Right Sidebar (Widgets) -->
    <aside class="right-sidebar">
      <div class="widget">
        <h3><%= t.course.instructor %></h3>
        <div style="display:flex; align-items:center; gap:12px;">
          <div style="width:40px; height:40px; border-radius:50%; background:var(--blue-soft); color:var(--blue); display:grid; place-items:center; font-weight:800;">
            <%= (course.teacher_name || 'T').charAt(0) %>
          </div>
          <div>
            <strong style="display:block; font-size:14px; color:var(--navy);"><%= course.teacher_name || 'TBA' %></strong>
          </div>
        </div>
      </div>
      
      <div class="widget">
        <h3><%= t.course.upcoming %></h3>
        <p><i class="fa-solid fa-file-pen" style="color:var(--blue);"></i> Assignment 1 Due</p>
        <p><i class="fa-solid fa-stopwatch" style="color:#d34d5b;"></i> Quiz 1 Opens</p>
      </div>
    </aside>
  </div>
</body>
</html>