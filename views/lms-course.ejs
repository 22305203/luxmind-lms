<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= course.code %> | LuxMind LMS</title>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800&family=Manrope:wght@500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
  <style>
    :root {
      --navy: #111d35; --page: #f4f6fa; --surface: #fff; --text: #172238; --muted: #718096;
      --line: #e6ebf2; --blue: #3867e8; --blue-soft: #edf2ff; --amber: #c98212; --amber-soft: #fff5df;
      --shadow: 0 8px 28px rgba(24, 39, 75, .055); --radius: 16px;
    }
    * { box-sizing: border-box; }
    body { margin: 0; min-height: 100vh; background: var(--page); color: var(--text); font-family: "DM Sans", sans-serif; }
    a { color: inherit; text-decoration: none; }
    
    .main { max-width: 1000px; margin: 0 auto; padding: 40px 20px; }
    .back-btn { display: inline-flex; align-items: center; gap: 8px; color: var(--muted); font-weight: 600; font-size: 14px; margin-bottom: 24px; transition: 0.2s; }
    .back-btn:hover { color: var(--navy); }
    
    .course-header { background: linear-gradient(135deg, var(--navy), #1c3155); color: #fff; padding: 40px; border-radius: var(--radius); margin-bottom: 30px; box-shadow: var(--shadow); }
    .course-code { display: inline-block; padding: 6px 12px; background: rgba(255,255,255,.15); border-radius: 8px; font-size: 12px; font-weight: 800; letter-spacing: 1px; margin-bottom: 16px; }
    .course-header h1 { margin: 0; font: 800 32px "Manrope", sans-serif; }
    
    .section-title { font: 800 20px "Manrope", sans-serif; color: #142039; margin-bottom: 20px; display: flex; align-items: center; gap: 10px; }
    
    .assignment-card { background: var(--surface); border: 1px solid var(--line); border-radius: 12px; padding: 24px; box-shadow: var(--shadow); margin-bottom: 16px; display: flex; justify-content: space-between; align-items: center; transition: 0.2s; }
    .assignment-card:hover { border-color: var(--blue); transform: translateY(-2px); }
    .assignment-info h3 { margin: 0 0 8px 0; font-size: 18px; color: #142039; }
    .assignment-meta { display: flex; gap: 16px; color: var(--muted); font-size: 13px; font-weight: 600; }
    .assignment-meta span { display: flex; align-items: center; gap: 6px; }
    .badge-due { color: var(--amber); background: var(--amber-soft); padding: 4px 10px; border-radius: 20px; font-size: 11px; font-weight: 800; }
    
    .btn-submit { padding: 10px 24px; background: var(--blue); color: #fff; border-radius: 8px; font-size: 13px; font-weight: 700; border: none; cursor: pointer; display: inline-flex; align-items: center; gap: 8px; transition: 0.2s; }
    .btn-submit:hover { background: #2a53c9; }
    
    .empty-state { background: var(--surface); padding: 60px 20px; text-align: center; border-radius: var(--radius); border: 1px dashed var(--line); color: var(--muted); }

    @media (max-width: 600px) {
      .assignment-card { flex-direction: column; align-items: flex-start; gap: 16px; }
      .btn-submit { width: 100%; justify-content: center; }
      .course-header { padding: 30px 20px; }
      .course-header h1 { font-size: 24px; }
    }
  </style>
</head>
<body>
  <main class="main">
    <a href="/dashboard" class="back-btn"><i class="fa-solid fa-arrow-left"></i> Back to My Courses</a>
    
    <div class="course-header">
      <span class="course-code"><%= course.code %></span>
      <h1><%= course.title %></h1>
    </div>

    <h2 class="section-title"><i class="fa-solid fa-list-check"></i> Course Assignments</h2>

    <% if (assignments.length === 0) { %>
      <div class="empty-state">
        <i class="fa-solid fa-clipboard-check" style="font-size:40px; color:#cbd5e1; margin-bottom:12px;"></i>
        <h3>No assignments yet</h3>
        <p>Your instructor hasn't posted any assignments for this course.</p>
      </div>
    <% } else { %>
      <% assignments.forEach(a => { %>
        <div class="assignment-card">
          <div class="assignment-info">
            <h3><%= a.title %></h3>
            <div class="assignment-meta">
              <span class="badge-due"><i class="fa-regular fa-clock"></i> Due: <%= new Date(a.due_date).toLocaleDateString('en-GB') %></span>
              <span><i class="fa-solid fa-star"></i> <%= a.max_points %> Points</span>
            </div>
          </div>
          <button class="btn-submit" onclick="alert('Submission feature coming in the next step!')">
            <i class="fa-solid fa-upload"></i> Submit Work
          </button>
        </div>
      <% }); %>
    <% } %>
  </main>
</body>
</html>