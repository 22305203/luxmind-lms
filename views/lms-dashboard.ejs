<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= t.portal_title %> | LuxMind</title>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
  <style>
    :root {
      --navy: #111d35; --navy-light: #1c2e4a; --page: #f4f6fa; --surface: #fff; 
      --text: #172238; --muted: #718096; --line: #e6ebf2; 
      --blue: #3867e8; --blue-soft: #edf2ff; --green: #15966b; --green-soft: #e9f8f1;
      --shadow: 0 4px 20px rgba(24, 39, 75, 0.05); --radius: 16px;
    }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body { min-height: 100vh; background: var(--page); color: var(--text); font-family: "DM Sans", sans-serif; display: flex; }
    a { color: inherit; text-decoration: none; }

    /* ============ RICH SIDEBAR ============ */
    .sidebar { width: 270px; background: var(--navy); color: #d9e2f2; display: flex; flex-direction: column; position: fixed; height: 100vh; overflow-y: auto; }
    .brand { display: flex; align-items: center; gap: 12px; padding: 24px; border-bottom: 1px solid rgba(255,255,255,0.08); }
    .brand-mark { width: 40px; height: 40px; border-radius: 10px; background: linear-gradient(135deg, #527df2, #3157cb); display: grid; place-items: center; font-size: 18px; color: white; }
    .brand-name { font: 800 18px "Manrope", sans-serif; color: white; letter-spacing: 0.5px; }
    
    .nav-group { padding: 20px 16px 0; }
    .nav-label { font-size: 10px; font-weight: 800; text-transform: uppercase; letter-spacing: 1px; color: #7f90ab; margin-bottom: 12px; padding-left: 12px; }
    .nav-link { display: flex; align-items: center; gap: 14px; padding: 12px 16px; border-radius: 10px; font-size: 14px; font-weight: 600; transition: 0.2s; margin-bottom: 4px; }
    .nav-link i { width: 20px; font-size: 16px; color: #91a2bd; text-align: center; }
    .nav-link:hover, .nav-link.active { background: rgba(255,255,255,0.08); color: white; }
    .nav-link.active { background: rgba(79,119,232,0.2); border-left: 3px solid #7796ff; border-radius: 4px 10px 10px 4px; }
    .nav-link.active i { color: #7796ff; }

    .sidebar-bottom { margin-top: auto; padding: 20px 16px; border-top: 1px solid rgba(255,255,255,0.08); }
    .user-profile { display: flex; align-items: center; gap: 12px; padding: 12px; background: rgba(255,255,255,0.05); border-radius: 12px; }
    .avatar { width: 38px; height: 38px; border-radius: 50%; background: linear-gradient(135deg, #527df2, #3157cb); color: white; display: grid; place-items: center; font-weight: 800; font-size: 14px; }
    .user-info p { font-size: 13px; font-weight: 700; color: white; margin-bottom: 2px; }
    .user-info span { font-size: 11px; color: #9eacc3; }
    .logout-icon { margin-left: auto; color: #ffb0b6; cursor: pointer; }

    /* ============ MAIN CONTENT ============ */
    .main { margin-left: 270px; padding: 32px 40px; flex: 1; width: calc(100% - 270px); }
    
    /* Top Bar */
    .topbar { display: flex; justify-content: space-between; align-items: center; margin-bottom: 32px; }
    .page-title { font: 800 24px "Manrope", sans-serif; color: var(--navy); }
    .top-actions { display: flex; align-items: center; gap: 16px; }
    
    .lang-select { padding: 8px 14px; border-radius: 8px; border: 1px solid var(--line); background: var(--surface); font-weight: 600; font-size: 13px; cursor: pointer; color: var(--navy); outline: none; }
    .notif-btn { position: relative; width: 40px; height: 40px; border-radius: 10px; border: 1px solid var(--line); background: var(--surface); cursor: pointer; color: var(--muted); font-size: 16px; }
    .notif-btn:hover { background: var(--page); color: var(--navy); }
    .notif-badge { position: absolute; top: -5px; right: -5px; background: #ef4444; color: white; font-size: 10px; font-weight: 800; width: 18px; height: 18px; border-radius: 50%; display: grid; place-items: center; border: 2px solid white; }

    /* Grid Layout */
    .layout-grid { display: grid; grid-template-columns: 1fr 320px; gap: 24px; }

    /* Greeting Banner */
    .greeting-banner { background: linear-gradient(135deg, var(--navy), var(--navy-light)); border-radius: var(--radius); padding: 32px; color: white; margin-bottom: 24px; position: relative; overflow: hidden; box-shadow: var(--shadow); }
    .greeting-banner::after { content: '\f19d'; font-family: 'FontAwesome'; position: absolute; right: -10px; bottom: -20px; font-size: 140px; color: rgba(255,255,255,0.03); }
    .greeting-banner h1 { font: 800 26px "Manrope", sans-serif; margin-bottom: 8px; }
    .greeting-banner p { font-size: 14px; color: #b8c5db; }

    /* Section Cards */
    .card { background: var(--surface); border-radius: var(--radius); border: 1px solid var(--line); box-shadow: var(--shadow); padding: 24px; margin-bottom: 24px; }
    .card-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; }
    .card-title { font: 800 18px "Manrope", sans-serif; color: var(--navy); }
    .btn-view-all { font-size: 13px; font-weight: 700; color: var(--blue); }

    /* Premium Course Grid */
    .course-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
    .course-card { border: 1px solid var(--line); border-radius: 12px; padding: 20px; transition: 0.2s; display: flex; flex-direction: column; background: #fafbfe; position: relative; overflow: hidden; }
    .course-card:hover { transform: translateY(-3px); box-shadow: 0 8px 20px rgba(0,0,0,0.06); border-color: var(--blue); background: white; }
    .course-card::before { content: ''; position: absolute; left: 0; top: 0; bottom: 0; width: 4px; background: var(--blue); }
    .course-code { display: inline-block; padding: 4px 8px; background: var(--blue-soft); color: var(--blue); border-radius: 6px; font-size: 11px; font-weight: 800; margin-bottom: 12px; align-self: flex-start; }
    .course-card h3 { font: 700 16px "Manrope", sans-serif; color: var(--navy); margin-bottom: 8px; line-height: 1.4; }
    .course-card p { font-size: 13px; color: var(--muted); display: flex; align-items: center; gap: 6px; margin-bottom: 16px; }
    .btn-enter { margin-top: auto; padding: 8px 16px; background: var(--page); color: var(--navy); border-radius: 8px; font-size: 12px; font-weight: 700; text-align: center; transition: 0.2s; }
    .course-card:hover .btn-enter { background: var(--blue); color: white; }

    /* Right Widgets */
    .widget-list { display: flex; flex-direction: column; gap: 12px; }
    .ann-item { display: flex; gap: 12px; padding-bottom: 12px; border-bottom: 1px solid var(--line); }
    .ann-item:last-child { border-bottom: 0; padding-bottom: 0; }
    .ann-icon { width: 36px; height: 36px; border-radius: 10px; background: #fff5df; color: #c98212; display: grid; place-items: center; font-size: 14px; flex-shrink: 0; }
    .ann-content h4 { font-size: 14px; font-weight: 700; color: var(--navy); margin-bottom: 4px; }
    .ann-content p { font-size: 12px; color: var(--muted); line-height: 1.4; }

    /* Online Users */
    .online-box { display: flex; align-items: center; gap: 12px; background: var(--green-soft); padding: 16px; border-radius: 12px; border: 1px solid #bcebd6; }
    .online-dot { width: 10px; height: 10px; border-radius: 50%; background: var(--green); box-shadow: 0 0 8px var(--green); }
    .online-box p { font-size: 13px; font-weight: 700; color: var(--green); }

    @media (max-width: 1024px) {
      .layout-grid { grid-template-columns: 1fr; }
      .course-grid { grid-template-columns: 1fr; }
    }
    @media (max-width: 768px) {
      .sidebar { transform: translateX(-100%); transition: 0.3s; }
      .sidebar.open { transform: translateX(0); }
      .main { margin-left: 0; width: 100%; padding: 20px; }
    }
  </style>
</head>
<body>

  <!-- Sidebar -->
  <aside class="sidebar">
    <div class="brand">
      <div class="brand-mark"><i class="fa-solid fa-book-open"></i></div>
      <div class="brand-name">LuxMind LMS</div>
    </div>
    
    <div class="nav-group">
      <div class="nav-label">Learning</div>
      <a href="/dashboard" class="nav-link active"><i class="fa-solid fa-house"></i> Dashboard</a>
      <a href="#" class="nav-link"><i class="fa-solid fa-graduation-cap"></i> My Courses</a>
      <a href="#" class="nav-link"><i class="fa-solid fa-calendar-days"></i> Calendar</a>
      <a href="#" class="nav-link"><i class="fa-solid fa-file-lines"></i> Assignments</a>
    </div>

    <div class="nav-group">
      <div class="nav-label">Communication</div>
      <a href="#" class="nav-link"><i class="fa-solid fa-comments"></i> Messages</a>
      <a href="#" class="nav-link"><i class="fa-solid fa-bullhorn"></i> Announcements</a>
    </div>

    <div class="nav-group" style="margin-bottom: 20px;">
      <div class="nav-label">Support</div>
      <a href="#" class="nav-link"><i class="fa-solid fa-circle-question"></i> Help Center</a>
      <a href="#" class="nav-link"><i class="fa-solid fa-gear"></i> Settings</a>
    </div>

    <div class="sidebar-bottom">
      <div class="user-profile">
        <div class="avatar"><%= user.full_name.charAt(0) %></div>
        <div class="user-info">
          <p><%= user.full_name %></p>
          <span><%= user.role %></span>
        </div>
        <a href="/logout" class="logout-icon" title="<%= t.nav.logout %>"><i class="fa-solid fa-power-off"></i></a>
      </div>
    </div>
  </aside>

  <!-- Main Content -->
  <main class="main">
    
    <!-- Topbar -->
    <header class="topbar">
      <h1 class="page-title">Dashboard</h1>
      <div class="top-actions">
        <select class="lang-select" onchange="window.location.href='/set-language/'+this.value">
          <option value="en" <%= lang === 'en' ? 'selected' : '' %>>🇬🇧 English</option>
          <option value="fr" <%= lang === 'fr' ? 'selected' : '' %>>🇫🇷 Français</option>
          <option value="rn" <%= lang === 'rn' ? 'selected' : '' %>>🇧🇮 Kirundi</option>
          <option value="sw" <%= lang === 'sw' ? 'selected' : '' %>>🇹🇿 Kiswahili</option>
        </select>
        <button class="notif-btn">
          <i class="fa-regular fa-bell"></i>
          <span class="notif-badge">3</span>
        </button>
      </div>
    </header>

    <!-- Layout Grid -->
    <div class="layout-grid">
      
      <!-- Left Column -->
      <div>
        <!-- Greeting -->
        <div class="greeting-banner">
          <h1><%= greeting %>, <%= user.full_name.split(' ')[0] %>!</h1>
          <p>Welcome back to your learning portal. You have courses to catch up on today.</p>
        </div>

        <!-- My Courses -->
        <div class="card">
          <div class="card-header">
            <h2 class="card-title"><%= t.dash.course_overview %></h2>
            <a href="#" class="btn-view-all">View All</a>
          </div>
          
          <% if (courses.length === 0) { %>
            <p style="color: var(--muted);"><%= t.dash.no_courses %></p>
          <% } else { %>
            <div class="course-grid">
              <% courses.forEach(c => { %>
                <a href="/course/<%= c.id %>" class="course-card">
                  <span class="course-code"><%= c.code %></span>
                  <h3><%= c.title %></h3>
                  <p><i class="fa-solid fa-user-tie"></i> <%= c.teacher_name || 'TBA' %></p>
                  <div class="btn-enter">Enter Course</div>
                </a>
              <% }); %>
            </div>
          <% } %>
        </div>
      </div>

      <!-- Right Column -->
      <div>
        
        <!-- Online Users -->
        <div class="online-box" style="margin-bottom: 24px;">
          <div class="online-dot"></div>
          <p><%= onlineUsers %> Users Currently Online</p>
        </div>

        <!-- Announcements -->
        <div class="card">
          <div class="card-header">
            <h2 class="card-title"><%= t.dash.site_ann %></h2>
          </div>
          
          <div class="widget-list">
            <% if (announcements.length === 0) { %>
              <p style="color: var(--muted); font-size:13px;"><%= t.dash.no_ann %></p>
            <% } else { %>
              <% announcements.slice(0, 4).forEach(a => { %>
                <div class="ann-item">
                  <div class="ann-icon"><i class="fa-solid fa-bullhorn"></i></div>
                  <div class="ann-content">
                    <h4><%= a.title %></h4>
                    <p><%= a.message %></p>
                    <span style="font-size: 10px; color: #a0aec0; margin-top: 4px; display: block;">
                      <%= new Date(a.created_at).toLocaleDateString('en-GB', {day: 'numeric', month: 'short'}) %>
                    </span>
                  </div>
                </div>
              <% }); %>
            <% } %>
          </div>
        </div>

      </div>

    </div>
  </main>
</body>
</html>