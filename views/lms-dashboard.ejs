<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= t.portal_title %> | LuxMind</title>
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
  <style>
    :root {
      --bg-body: #f1f5f9;
      --bg-surface: #ffffff;
      --sidebar-bg: #0f172a;
      --sidebar-hover: #1e293b;
      --text-main: #0f172a;
      --text-muted: #64748b;
      --primary: #4f46e5;
      --primary-hover: #4338ca;
      --accent-1: #0ea5e9;
      --accent-2: #f59e0b;
      --accent-3: #10b981;
      --border: #e2e8f0;
      --radius-lg: 24px;
      --radius-md: 16px;
      --shadow-sm: 0 1px 3px rgba(0,0,0,0.05);
      --shadow-md: 0 4px 12px rgba(15, 23, 42, 0.05);
      --shadow-lg: 0 20px 40px rgba(15, 23, 42, 0.08);
    }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: 'Inter', sans-serif; background: var(--bg-body); color: var(--text-main); display: flex; min-height: 100vh; -webkit-font-smoothing: antialiased; }
    a { text-decoration: none; color: inherit; }
    h1, h2, h3, h4 { font-family: 'Outfit', sans-serif; }

    /* ================= SIDEBAR ================= */
    .sidebar { width: 280px; background: var(--sidebar-bg); color: #94a3b8; display: flex; flex-direction: column; position: fixed; height: 100vh; padding: 32px 20px; border-right: 1px solid rgba(255,255,255,0.05); }
    
    .brand { display: flex; align-items: center; gap: 14px; padding: 0 12px 32px; margin-bottom: 16px; }
    .brand-logo { width: 40px; height: 40px; background: linear-gradient(135deg, #4f46e5, #0ea5e9); border-radius: 12px; display: grid; place-items: center; color: white; font-size: 20px; box-shadow: 0 8px 20px rgba(79,70,229,0.4); }
    .brand-text { font-family: 'Outfit', sans-serif; font-weight: 700; font-size: 20px; color: white; letter-spacing: 0.5px; }
    
    .nav-group { margin-bottom: 32px; }
    .nav-label { font-size: 11px; font-weight: 700; color: #475569; text-transform: uppercase; letter-spacing: 1.5px; margin: 0 12px 12px; }
    .nav-link { display: flex; align-items: center; gap: 14px; padding: 12px 14px; border-radius: 12px; font-size: 14px; font-weight: 500; transition: all 0.3s ease; margin-bottom: 4px; color: #94a3b8; }
    .nav-link i { font-size: 18px; width: 24px; text-align: center; transition: 0.3s; }
    .nav-link:hover { background: var(--sidebar-hover); color: white; }
    .nav-link.active { background: linear-gradient(90deg, rgba(79,70,229,0.15), transparent); color: white; border-left: 3px solid #4f46e5; border-radius: 4px 12px 12px 4px; }
    .nav-link.active i { color: #4f46e5; }

    .sidebar-profile { margin-top: auto; padding: 20px; background: var(--sidebar-hover); border-radius: var(--radius-md); display: flex; align-items: center; gap: 14px; }
    .avatar { width: 42px; height: 42px; border-radius: 50%; background: linear-gradient(135deg, #0ea5e9, #4f46e5); color: white; display: grid; place-items: center; font-weight: 700; font-size: 16px; font-family: 'Outfit'; }
    .profile-info p { font-size: 14px; font-weight: 600; color: white; margin-bottom: 2px; }
    .profile-info span { font-size: 12px; color: #64748b; }
    .logout-icon { margin-left: auto; color: #ef4444; font-size: 16px; cursor: pointer; transition: 0.2s; }
    .logout-icon:hover { transform: translateX(3px); }

    /* ================= MAIN CONTENT ================= */
    .main { margin-left: 280px; flex: 1; padding: 0 48px 48px; }
    
    /* TOP BAR */
    .topbar { height: 96px; display: flex; align-items: center; justify-content: space-between; position: sticky; top: 0; background: rgba(241, 245, 249, 0.8); backdrop-filter: blur(12px); z-index: 10; margin-bottom: 32px; }
    .page-title { font-size: 32px; font-weight: 800; color: var(--text-main); letter-spacing: -0.5px; }
    
    .top-actions { display: flex; align-items: center; gap: 16px; }
    
    /* Search Bar */
    .search-bar { display: flex; align-items: center; gap: 10px; background: white; border: 1px solid var(--border); padding: 10px 16px; border-radius: 30px; width: 260px; box-shadow: var(--shadow-sm); transition: 0.2s; }
    .search-bar:focus-within { border-color: var(--primary); box-shadow: 0 0 0 3px rgba(79,70,229,0.1); }
    .search-bar i { color: var(--text-muted); font-size: 14px; }
    .search-bar input { border: none; outline: none; background: transparent; font-size: 14px; width: 100%; color: var(--text-main); }

    /* Actions */
    .lang-select { background: white; border: 1px solid var(--border); padding: 10px 16px; border-radius: 30px; font-size: 13px; font-weight: 600; color: var(--text-main); outline: none; cursor: pointer; box-shadow: var(--shadow-sm); }
    .icon-btn { width: 44px; height: 44px; border-radius: 50%; background: white; border: 1px solid var(--border); color: var(--text-main); display: grid; place-items: center; cursor: pointer; box-shadow: var(--shadow-sm); position: relative; transition: 0.2s; }
    .icon-btn:hover { background: var(--bg-body); }
    .notif-badge { position: absolute; top: 10px; right: 12px; width: 8px; height: 8px; background: #ef4444; border-radius: 50%; border: 2px solid white; }

    /* ================= GRID LAYOUT ================= */
    .grid-container { display: grid; grid-template-columns: 2fr 1fr; gap: 32px; }

    /* HERO BANNER */
    .hero { background: linear-gradient(135deg, #1e1b4b 0%, #4f46e5 100%); border-radius: var(--radius-lg); padding: 40px; color: white; position: relative; overflow: hidden; box-shadow: var(--shadow-lg); margin-bottom: 32px; display: flex; justify-content: space-between; align-items: center; }
    .hero-text h1 { font-size: 32px; font-weight: 800; margin-bottom: 12px; letter-spacing: -0.5px; }
    .hero-text p { font-size: 16px; color: #c7d2fe; max-width: 400px; line-height: 1.6; }
    .hero-illustration { font-size: 120px; color: rgba(255,255,255,0.1); position: absolute; right: 40px; top: 50%; transform: translateY(-50%) rotate(-10deg); }

    /* CARDS COMMON */
    .card { background: var(--bg-surface); border-radius: var(--radius-lg); padding: 32px; border: 1px solid var(--border); box-shadow: var(--shadow-md); margin-bottom: 32px; }
    .card-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px; }
    .card-title { font-size: 20px; font-weight: 700; color: var(--text-main); }
    .card-link { font-size: 13px; font-weight: 600; color: var(--primary); }

    /* COURSES */
    .course-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
    .course-card { background: #f8fafc; border: 1px solid var(--border); border-radius: var(--radius-md); padding: 24px; transition: all 0.3s ease; position: relative; display: flex; flex-direction: column; overflow: hidden; }
    .course-card:hover { background: white; box-shadow: var(--shadow-lg); transform: translateY(-4px); border-color: #cbd5e1; }
    
    .course-card::before { content: ''; position: absolute; top: 0; left: 0; width: 100%; height: 4px; background: var(--primary); }
    .course-card:nth-child(2)::before { background: var(--accent-2); }
    .course-card:nth-child(3)::before { background: var(--accent-3); }
    .course-card:nth-child(4)::before { background: var(--accent-1); }

    .course-icon-wrapper { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 16px; }
    .course-icon { width: 48px; height: 48px; border-radius: 12px; background: #e0e7ff; color: var(--primary); display: grid; place-items: center; font-size: 20px; }
    .course-code { font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 1px; color: var(--text-muted); background: white; padding: 4px 8px; border-radius: 6px; border: 1px solid var(--border); }
    
    .course-card h3 { font-size: 18px; font-weight: 700; color: var(--text-main); margin-bottom: 8px; line-height: 1.3; }
    .course-instructor { font-size: 13px; color: var(--text-muted); display: flex; align-items: center; gap: 6px; margin-bottom: 24px; }
    
    .course-progress { margin-bottom: 20px; }
    .course-progress-bar { height: 6px; background: #e2e8f0; border-radius: 10px; overflow: hidden; }
    .course-progress-fill { height: 100%; background: var(--primary); width: 45%; border-radius: 10px; }
    
    .btn-enter { display: inline-flex; justify-content: center; align-items: center; width: 100%; padding: 12px; border-radius: 10px; background: white; border: 1px solid var(--border); color: var(--text-main); font-weight: 600; font-size: 14px; transition: 0.2s; margin-top: auto; }
    .course-card:hover .btn-enter { background: var(--text-main); color: white; border-color: var(--text-main); }

    /* WIDGETS */
    .widget-title { font-size: 18px; font-weight: 700; margin-bottom: 20px; display: flex; align-items: center; gap: 10px; }
    .widget-title i { color: var(--primary); }

    /* Online Users */
    .online-widget { display: flex; align-items: center; justify-content: space-between; background: linear-gradient(135deg, #ecfdf5, #d1fae5); padding: 20px; border-radius: var(--radius-md); border: 1px solid #a7f3d0; }
    .online-text h4 { font-size: 16px; font-weight: 700; color: #065f46; }
    .online-text p { font-size: 13px; color: #047857; }
    .pulse-dot { width: 12px; height: 12px; background: #10b981; border-radius: 50%; box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.7); animation: pulse 2s infinite; }
    @keyframes pulse { 0% { box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.7); } 70% { box-shadow: 0 0 0 10px rgba(16, 185, 129, 0); } 100% { box-shadow: 0 0 0 0 rgba(16, 185, 129, 0); } }

    /* Announcements */
    .ann-list { display: flex; flex-direction: column; gap: 16px; }
    .ann-item { display: flex; gap: 16px; }
    .ann-icon { width: 40px; height: 40px; border-radius: 50%; background: #fff7ed; color: #f59e0b; display: grid; place-items: center; font-size: 16px; flex-shrink: 0; }
    .ann-content h4 { font-size: 14px; font-weight: 600; color: var(--text-main); margin-bottom: 4px; }
    .ann-content p { font-size: 13px; color: var(--text-muted); line-height: 1.5; margin-bottom: 6px; }
    .ann-date { font-size: 11px; font-weight: 600; color: #94a3b8; text-transform: uppercase; letter-spacing: 0.5px; }

    @media (max-width: 1024px) {
      .grid-container { grid-template-columns: 1fr; }
      .course-grid { grid-template-columns: 1fr; }
      .hero-illustration { display: none; }
    }
    @media (max-width: 768px) {
      .sidebar { transform: translateX(-100%); transition: 0.3s; }
      .sidebar.open { transform: translateX(0); }
      .main { margin-left: 0; padding: 0 20px 20px; }
      .topbar { flex-direction: column; height: auto; padding: 20px 0; gap: 16px; align-items: flex-start; }
      .top-actions { width: 100%; justify-content: space-between; }
      .search-bar { width: 100%; }
    }
  </style>
</head>
<body>

  <!-- Sidebar -->
  <aside class="sidebar">
    <div class="brand">
      <div class="brand-logo"><i class="fa-solid fa-graduation-cap"></i></div>
      <div class="brand-text">LuxMind</div>
    </div>
    
    <div class="nav-group">
      <div class="nav-label">Main Menu</div>
      <a href="/dashboard" class="nav-link active"><i class="fa-solid fa-grid-2"></i> Dashboard</a>
      <a href="#" class="nav-link"><i class="fa-solid fa-book-open"></i> My Courses</a>
      <a href="#" class="nav-link"><i class="fa-solid fa-calendar-days"></i> Schedule</a>
      <a href="#" class="nav-link"><i class="fa-solid fa-file-signature"></i> Assignments</a>
    </div>

    <div class="nav-group">
      <div class="nav-label">Communication</div>
      <a href="#" class="nav-link"><i class="fa-solid fa-comments"></i> Messages <span style="background:#4f46e5; color:white; font-size:10px; padding:2px 6px; border-radius:10px; margin-left:auto;">3</span></a>
      <a href="#" class="nav-link"><i class="fa-solid fa-bullhorn"></i> Announcements</a>
      <a href="#" class="nav-link"><i class="fa-solid fa-users"></i> Study Groups</a>
    </div>

    <div class="nav-group">
      <div class="nav-label">Support</div>
      <a href="#" class="nav-link"><i class="fa-solid fa-circle-info"></i> Help Center</a>
      <a href="#" class="nav-link"><i class="fa-solid fa-gear"></i> Settings</a>
    </div>

    <div class="sidebar-profile">
      <div class="avatar"><%= user.full_name.charAt(0) %></div>
      <div class="profile-info">
        <p><%= user.full_name.split(' ')[0] %></p>
        <span><%= user.role %></span>
      </div>
      <a href="/logout" class="logout-icon" title="<%= t.nav.logout %>"><i class="fa-solid fa-arrow-right-from-bracket"></i></a>
    </div>
  </aside>

  <!-- Main Content -->
  <main class="main">
    
    <!-- Topbar -->
    <header class="topbar">
      <h1 class="page-title">Dashboard</h1>
      <div class="top-actions">
        <div class="search-bar">
          <i class="fa-solid fa-magnifying-glass"></i>
          <input type="text" placeholder="Search courses...">
        </div>
        <select class="lang-select" onchange="window.location.href='/set-language/'+this.value">
          <option value="en" <%= lang === 'en' ? 'selected' : '' %>>🇬🇧 EN</option>
          <option value="fr" <%= lang === 'fr' ? 'selected' : '' %>>🇫🇷 FR</option>
          <option value="rn" <%= lang === 'rn' ? 'selected' : '' %>>🇧🇮 RN</option>
          <option value="sw" <%= lang === 'sw' ? 'selected' : '' %>>🇹🇿 SW</option>
        </select>
        <button class="icon-btn">
          <i class="fa-regular fa-bell"></i>
          <span class="notif-badge"></span>
        </button>
      </div>
    </header>

    <!-- Grid Layout -->
    <div class="grid-container">
      
      <!-- Left Column -->
      <div>
        <!-- Hero Banner -->
        <div class="hero">
          <div class="hero-text">
            <h1><%= greeting %>, <%= user.full_name.split(' ')[0] %>!</h1>
            <p>Welcome back to your learning portal. You have 2 assignments due this week. Keep up the great work!</p>
          </div>
          <i class="fa-solid fa-graduation-cap hero-illustration"></i>
        </div>

        <!-- Courses -->
        <div class="card">
          <div class="card-header">
            <h2 class="card-title">My Active Courses</h2>
            <a href="#" class="card-link">View All</a>
          </div>
          
          <% if (courses.length === 0) { %>
            <p style="color: var(--text-muted);"><%= t.dash.no_courses %></p>
          <% } else { %>
            <div class="course-grid">
              <% courses.forEach((c, index) => { 
                 const icons = ['fa-laptop-code', 'fa-chart-pie', 'fa-flask', 'fa-palette'];
                 const icon = icons[index % icons.length];
              %>
                <a href="/course/<%= c.id %>" class="course-card">
                  <div class="course-icon-wrapper">
                    <div class="course-icon"><i class="fa-solid <%= icon %>"></i></div>
                    <div class="course-code"><%= c.code %></div>
                  </div>
                  <h3><%= c.title %></h3>
                  <div class="course-instructor"><i class="fa-regular fa-user"></i> <%= c.teacher_name || 'TBA' %></div>
                  
                  <div class="course-progress">
                    <div style="display:flex; justify-content:space-between; font-size:11px; font-weight:600; color:var(--text-muted); margin-bottom:6px;">
                      <span>Course Progress</span>
                      <span>45%</span>
                    </div>
                    <div class="course-progress-bar">
                      <div class="course-progress-fill"></div>
                    </div>
                  </div>
                  
                  <div class="btn-enter">Enter Course <i class="fa-solid fa-arrow-right" style="margin-left:8px; font-size:12px;"></i></div>
                </a>
              <% }); %>
            </div>
          <% } %>
        </div>
      </div>

      <!-- Right Column -->
      <div>
        
        <!-- Online Users -->
        <div class="online-widget" style="margin-bottom: 32px;">
          <div class="online-text">
            <h4>Campus Activity</h4>
            <p><%= onlineUsers %> students online now</p>
          </div>
          <div class="pulse-dot"></div>
        </div>

        <!-- Announcements -->
        <div class="card">
          <h2 class="widget-title"><i class="fa-solid fa-bullhorn"></i> Announcements</h2>
          
          <div class="ann-list">
            <% if (announcements.length === 0) { %>
              <p style="color: var(--text-muted); font-size:14px;"><%= t.dash.no_ann %></p>
            <% } else { %>
              <% announcements.slice(0, 3).forEach(a => { %>
                <div class="ann-item">
                  <div class="ann-icon"><i class="fa-solid fa-star"></i></div>
                  <div class="ann-content">
                    <h4><%= a.title %></h4>
                    <p><%= a.message %></p>
                    <span class="ann-date"><%= new Date(a.created_at).toLocaleDateString('en-GB', {day: 'numeric', month: 'short'}) %></span>
                  </div>
                </div>
              <% }); %>
            <% } %>
          </div>
        </div>

        <!-- Quick Links (Extra Widget) -->
        <div class="card">
          <h2 class="widget-title"><i class="fa-solid fa-link"></i> Quick Links</h2>
          <div style="display:flex; flex-direction:column; gap:12px;">
            <a href="https://luxmind-sis-v2-2c2t.onrender.com/login" target="_blank" style="display:flex; align-items:center; gap:12px; padding:12px; background:#f8fafc; border-radius:10px; font-size:14px; font-weight:600; border:1px solid var(--border); transition:0.2s;">
              <div style="width:32px; height:32px; background:#e0e7ff; color:#4f46e5; border-radius:8px; display:grid; place-items:center;"><i class="fa-solid fa-building-columns"></i></div>
              Go to SIS Portal
            </a>
            <a href="#" style="display:flex; align-items:center; gap:12px; padding:12px; background:#f8fafc; border-radius:10px; font-size:14px; font-weight:600; border:1px solid var(--border); transition:0.2s;">
              <div style="width:32px; height:32px; background:#ecfdf5; color:#10b981; border-radius:8px; display:grid; place-items:center;"><i class="fa-solid fa-book"></i></div>
              Library Resources
            </a>
          </div>
        </div>

      </div>
    </div>
  </main>
</body>
</html>