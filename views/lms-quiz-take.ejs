<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= quiz.title %> — Quiz in progress</title>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@600;700;800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
  <style>
    :root {
      --bg: #f4f6fa; --surface: #ffffff; --text: #0f172a; --muted: #64748b;
      --border: #e2e8f0; --primary: #4f46e5; --danger: #ef4444; --warn: #f59e0b;
    }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: 'Inter', sans-serif; background: var(--bg); color: var(--text); min-height: 100vh; }
    .exam-shell { max-width: 820px; margin: 0 auto; padding: 24px; }
    .exam-header {
      background: var(--surface); border: 1px solid var(--border); border-radius: 16px;
      padding: 20px 24px; margin-bottom: 20px;
      display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 16px;
      position: sticky; top: 16px; z-index: 10; box-shadow: 0 4px 16px rgba(15,23,42,0.06);
    }
    .timer {
      font-family: 'Plus Jakarta Sans', sans-serif; font-size: 28px; font-weight: 800;
      color: var(--primary); letter-spacing: 1px;
    }
    .timer.warn { color: var(--warn); }
    .timer.danger { color: var(--danger); animation: pulse 1s infinite; }
    @keyframes pulse { 50% { opacity: 0.6; } }
    .q-counter { font-size: 13px; font-weight: 600; color: var(--muted); }
    .q-counter strong { color: var(--text); font-size: 15px; }
    .warning-banner {
      display: none; background: rgba(239,68,68,0.1); border: 1px solid rgba(239,68,68,0.3);
      color: #b91c1c; padding: 12px 18px; border-radius: 10px; margin-bottom: 16px;
      font-weight: 600; font-size: 14px;
    }
    .warning-banner.show { display: block; }
    .card {
      background: var(--surface); border: 1px solid var(--border); border-radius: 16px;
      padding: 32px; box-shadow: 0 2px 8px rgba(15,23,42,0.04);
    }
    .prompt { font: 700 20px/1.4 'Plus Jakarta Sans', sans-serif; margin-bottom: 24px; }
    .choices { display: flex; flex-direction: column; gap: 10px; }
    .choice {
      display: flex; align-items: center; gap: 12px; padding: 14px 18px;
      border: 1px solid var(--border); border-radius: 12px; cursor: pointer;
      transition: 0.15s; font-size: 15px;
    }
    .choice:hover { border-color: var(--primary); background: rgba(79,70,229,0.04); }
    .choice input { accent-color: var(--primary); width: 18px; height: 18px; flex-shrink: 0; }
    .choice.selected { border-color: var(--primary); background: rgba(79,70,229,0.08); }
    .text-answer {
      width: 100%; padding: 14px 16px; border: 1px solid var(--border); border-radius: 10px;
      font-family: inherit; font-size: 15px; resize: vertical;
    }
    .text-answer:focus { outline: none; border-color: var(--primary); box-shadow: 0 0 0 3px rgba(79,70,229,0.1); }
    .actions { display: flex; justify-content: flex-end; margin-top: 24px; }
    .btn-next {
      background: var(--primary); color: white; border: none; padding: 14px 32px;
      border-radius: 10px; font-weight: 700; font-size: 15px; cursor: pointer;
      display: inline-flex; align-items: center; gap: 8px; transition: 0.15s;
    }
    .btn-next:hover { background: #4338ca; }
    .btn-next:disabled { opacity: 0.5; cursor: not-allowed; }
    .notice { font-size: 12px; color: var(--muted); margin-top: 16px; text-align: center; }
  </style>
</head>
<body>
<div class="exam-shell">

  <div class="exam-header">
    <div>
      <div class="q-counter">
        Question <strong><%= questionNumber %></strong> of <strong><%= totalQuestions %></strong>
      </div>
      <div style="font-size:12px; color:var(--muted); margin-top:4px;">
        <%= quiz.title %>
      </div>
    </div>
    <div id="timer" class="timer"><%= Math.floor(remainingSeconds / 60) %>:<%= String(remainingSeconds % 60).padStart(2, '0') %></div>
  </div>

  <div id="warningBanner" class="warning-banner">
    <i class="fa-solid fa-triangle-exclamation"></i>
    Warning <span id="warningCount"><%= warningsCount %></span> of <span id="maxWarnings"><%= maxWarnings %></span>.
    Leaving this tab may auto-submit your quiz.
  </div>

  <form id="answerForm" method="POST" action="/course/<%= course.id %>/quizzes/<%= quiz.id %>/answer">
    <div class="card">
      <div class="prompt"><%= currentQ.prompt %></div>

      <% if (currentQ.type === 'MCQ') { %>
        <div class="choices">
          <% choices.forEach(c => { %>
            <% const checked = existingAnswer && existingAnswer.student_answer && Array.isArray(existingAnswer.student_answer.choice_ids) && existingAnswer.student_answer.choice_ids.includes(c.id); %>
            <label class="choice <%= checked ? 'selected' : '' %>">
              <input type="checkbox" name="choice_ids" value="<%= c.id %>" <%= checked ? 'checked' : '' %>>
              <span><%= c.text %></span>
            </label>
          <% }); %>
        </div>

      <% } else if (currentQ.type === 'TF') { %>
        <div class="choices">
          <% const tfVal = existingAnswer && existingAnswer.student_answer ? existingAnswer.student_answer.value : null; %>
          <label class="choice <%= tfVal === true ? 'selected' : '' %>">
            <input type="radio" name="tf_value" value="true" <%= tfVal === true ? 'checked' : '' %>>
            <span>True</span>
          </label>
          <label class="choice <%= tfVal === false ? 'selected' : '' %>">
            <input type="radio" name="tf_value" value="false" <%= tfVal === false ? 'checked' : '' %>>
            <span>False</span>
          </label>
        </div>

      <% } else { %>
        <% const textVal = existingAnswer && existingAnswer.student_answer ? (existingAnswer.student_answer.value || '') : ''; %>
        <% if (currentQ.type === 'ESSAY') { %>
          <textarea name="text_value" class="text-answer" rows="8" placeholder="Type your answer here..."><%= textVal %></textarea>
        <% } else { %>
          <textarea name="text_value" class="text-answer" rows="3" placeholder="Type your answer here..."><%= textVal %></textarea>
        <% } %>
      <% } %>

      <div class="actions">
        <button type="submit" class="btn-next" id="nextBtn">
          <% if (questionNumber >= totalQuestions) { %>
            Submit Quiz <i class="fa-solid fa-check"></i>
          <% } else { %>
            Next Question <i class="fa-solid fa-arrow-right"></i>
          <% } %>
        </button>
      </div>
    </div>
  </form>

  <p class="notice">
    Answers are saved server-side. Timer is authoritative on the server.
    <% if (quiz.anti_cheat_enabled) { %>
      Tab switching is monitored.
    <% } %>
  </p>
</div>

<script>
(function () {
  const remaining = <%= remainingSeconds %>;
  const timerEl = document.getElementById('timer');
  const form = document.getElementById('answerForm');
  const nextBtn = document.getElementById('nextBtn');
  let secondsLeft = remaining;
  let submitted = false;

  function tick() {
    if (submitted) return;
    secondsLeft--;
    if (secondsLeft <= 0) {
      timerEl.textContent = '0:00';
      timerEl.classList.add('danger');
      submitNow();
      return;
    }
    const m = Math.floor(secondsLeft / 60);
    const s = secondsLeft % 60;
    timerEl.textContent = m + ':' + String(s).padStart(2, '0');
    timerEl.classList.toggle('warn', secondsLeft <= 300 && secondsLeft > 60);
    timerEl.classList.toggle('danger', secondsLeft <= 60);
  }
  if (remaining > 0) setInterval(tick, 1000);

  function submitNow() {
    if (submitted) return;
    submitted = true;
    nextBtn.disabled = true;
    // If last question, POST to /submit instead of /answer? The route handles last question automatically.
    form.submit();
  }

  // Prevent accidental double-submit
  form.addEventListener('submit', function (e) {
    if (submitted) { e.preventDefault(); return; }
    submitted = true;
    nextBtn.disabled = true;
  });

  // Auto-submit when timer expires (send empty answer then submit route will handle)
  // The server also rejects answers after ends_at, so this is belt-and-braces.

  // ---------- Anti-cheat: tab switch detection ----------
  <% if (quiz.anti_cheat_enabled) { %>
  let warnings = <%= warningsCount %>;
  const maxWarnings = <%= maxWarnings %>;
  const banner = document.getElementById('warningBanner');
  const wCount = document.getElementById('warningCount');
  const wMax = document.getElementById('maxWarnings');

  document.addEventListener('visibilitychange', function () {
    if (document.visibilityState === 'hidden') {
      fetch('/course/<%= course.id %>/quizzes/<%= quiz.id %>/flag', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ reason: 'tab_switch' })
      })
      .then(r => r.json())
      .then(data => {
        if (data.ignored) return;
        warnings = data.warnings;
        wCount.textContent = warnings;
        wMax.textContent = maxWarnings;
        banner.classList.add('show');
        if (data.submitted) {
          submitted = true;
          window.location.href = '/course/<%= course.id %>/quizzes/<%= quiz.id %>/result';
        }
      })
      .catch(() => {});
    }
  });

  // Block copy/paste (optional, lightweight)
  ['copy', 'cut', 'paste'].forEach(ev => {
    document.addEventListener(ev, e => e.preventDefault());
  });
  document.addEventListener('contextmenu', e => e.preventDefault());
  <% } %>
})();
</script>
</body>
</html>