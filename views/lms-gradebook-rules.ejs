<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Grade Rules — <%= course.code %></title>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@600;700;800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
  <style>
    :root { --bg:#f4f6fa; --surface:#fff; --text:#0f172a; --muted:#64748b; --border:#e2e8f0; --primary:#4f46e5; --danger:#ef4444; --ok:#10b981; --warn:#f59e0b; }
    * { box-sizing:border-box; margin:0; padding:0; }
    body { font-family:'Inter',sans-serif; background:var(--bg); color:var(--text); padding:32px; }
    .shell { max-width:1000px; margin:0 auto; }
    h1 { font:800 26px 'Plus Jakarta Sans',sans-serif; margin-bottom:6px; }
    h2 { font:700 18px 'Plus Jakarta Sans',sans-serif; margin-bottom:14px; }
    .sub { color:var(--muted); margin-bottom:24px; font-size:14px; }
    .card { background:var(--surface); border:1px solid var(--border); border-radius:16px; padding:24px; margin-bottom:20px; }
    .banner { padding:14px 18px; border-radius:10px; margin-bottom:16px; font-weight:600; font-size:14px; }
    .banner.error { background:rgba(239,68,68,0.1); border:1px solid rgba(239,68,68,0.3); color:#b91c1c; }
    .banner.success { background:rgba(16,185,129,0.1); border:1px solid rgba(16,185,129,0.3); color:#047857; }
    .banner.warn { background:rgba(245,158,11,0.1); border:1px solid rgba(245,158,11,0.3); color:#b45309; }
    label { display:block; font-size:13px; font-weight:600; color:var(--muted); margin-bottom:6px; }
    input[type=text], input[type=number], select {
      width:100%; padding:11px 14px; border:1px solid var(--border); border-radius:10px;
      font-family:inherit; font-size:14px; background:#fff;
    }
    input:focus, select:focus { outline:none; border-color:var(--primary); box-shadow:0 0 0 3px rgba(79,70,229,0.1); }
    .row { display:grid; gap:16px; margin-bottom:16px; }
    .row-3 { grid-template-columns:1fr 1fr 1fr; }
    .row-2 { grid-template-columns:1fr 1fr; }
    .btn { padding:11px 20px; border-radius:10px; font-weight:700; font-size:14px; border:none; cursor:pointer; display:inline-flex; align-items:center; gap:8px; }
    .btn-primary { background:var(--primary); color:#fff; }
    .btn-primary:hover { background:#4338ca; }
    .btn-outline { background:transparent; color:var(--text); border:1px solid var(--border); }
    .btn-outline:hover { background:var(--bg); }
    .btn-danger { background:transparent; color:var(--danger); border:1px solid var(--danger); padding:6px 10px; font-size:12px; }
    .btn-danger:hover { background:var(--danger); color:#fff; }
    .btn-add { background:rgba(79,70,229,0.1); color:var(--primary); border:1px dashed var(--primary); }
    .btn-add:hover { background:rgba(79,70,229,0.2); }
    .cat-block { border:1px solid var(--border); border-radius:12px; padding:16px; margin-bottom:12px; background:#fff; }
    .cat-header { display:grid; grid-template-columns:2fr 100px 100px 40px; gap:12px; align-items:end; margin-bottom:12px; }
    .cat-items { border-top:1px solid var(--border); padding-top:12px; }
    .cat-items-title { font-size:12px; font-weight:700; color:var(--muted); text-transform:uppercase; margin-bottom:8px; }
    .item-grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(220px,1fr)); gap:8px; }
    .item-check { display:flex; align-items:center; gap:8px; padding:8px 10px; border:1px solid var(--border); border-radius:8px; font-size:13px; cursor:pointer; }
    .item-check:hover { border-color:var(--primary); background:rgba(79,70,229,0.04); }
    .item-check input { accent-color:var(--primary); }
    .item-check.disabled { opacity:0.4; cursor:not-allowed; }
    .item-type-badge { font-size:10px; font-weight:800; padding:2px 6px; border-radius:4px; text-transform:uppercase; }
    .badge-assignment { background:rgba(245,158,11,0.15); color:#b45309; }
    .badge-quiz { background:rgba(79,70,229,0.15); color:#4338ca; }
    .total-bar { display:flex; justify-content:space-between; align-items:center; padding:14px 18px; border-radius:10px; font-weight:700; margin-bottom:16px; }
    .total-bar.ok { background:rgba(16,185,129,0.1); color:#047857; border:1px solid rgba(16,185,129,0.3); }
    .total-bar.warn { background:rgba(245,158,11,0.1); color:#b45309; border:1px solid rgba(245,158,11,0.3); }
    .total-bar.bad { background:rgba(239,68,68,0.1); color:#b91c1c; border:1px solid rgba(239,68,68,0.3); }
    .back-link { display:inline-block; margin-bottom:20px; font-size:13px; font-weight:600; color:var(--primary); text-decoration:none; margin-right:16px; }
    .empty { padding:32px; text-align:center; color:var(--muted); font-size:14px; background:var(--bg); border-radius:10px; }
    code { background:var(--bg); padding:2px 6px; border-radius:4px; font-size:12px; }
    .hint { color:var(--muted); font-size:13px; margin-bottom:12px; line-height:1.5; }
  </style>
</head>
<body>
<div class="shell">

  <a href="/course/<%= course.id %>?view=grades" class="back-link"><i class="fa-solid fa-arrow-left"></i> Back to grades</a>
  <a href="/course/<%= course.id %>/gradebook/setup" class="back-link"><i class="fa-solid fa-table-list"></i> Letter scheme</a>

  <h1>Grade Rules</h1>
  <p class="sub"><%= course.code %> — <%= course.title %></p>

  <% if (flashError) { %><div class="banner error"><i class="fa-solid fa-circle-exclamation"></i> <%= flashError %></div><% } %>
  <% if (flashSuccess) { %><div class="banner success"><i class="fa-solid fa-circle-check"></i> <%= flashSuccess %></div><% } %>

  <!-- ============================================ -->
  <!-- GENERAL SETTINGS -->
  <!-- ============================================ -->
  <div class="card">
    <h2>Calculation Rules</h2>
    <form method="POST" action="/course/<%= course.id %>/gradebook/setup/rules/general">
      <div class="row row-3">
        <div>
          <label>Weighting Mode</label>
          <select name="weighting_mode">
            <option value="weighted" <%= settings.weighting_mode === 'weighted' ? 'selected' : '' %>>Weighted categories</option>
            <option value="simple" <%= settings.weighting_mode === 'simple' ? 'selected' : '' %>>Simple sum (no categories)</option>
          </select>
        </div>
        <div>
          <label>Curve</label>
          <select name="curve_mode" <%= settings.curve_locked ? 'disabled' : '' %>>
            <option value="none" <%= settings.curve_mode === 'none' ? 'selected' : '' %>>None</option>
            <option value="linear_max100" <%= settings.curve_mode === 'linear_max100' ? 'selected' : '' %>>Linear to 100 (top scorer)</option>
            <option value="linear_mean" <%= settings.curve_mode === 'linear_mean' ? 'selected' : '' %>>Linear to mean (75)</option>
            <option value="sqrt" <%= settings.curve_mode === 'sqrt' ? 'selected' : '' %>>Square root</option>
            <option value="bell" <%= settings.curve_mode === 'bell' ? 'selected' : '' %>>Z-score bell</option>
          </select>
          <% if (settings.curve_locked) { %><input type="hidden" name="curve_mode" value="<%= settings.curve_mode %>"><% } %>
        </div>
        <div>
          <label>Rounding</label>
          <select name="rounding_rule">
            <option value="half_up" <%= settings.rounding_rule === 'half_up' ? 'selected' : '' %>>Half-up (89.5 → 90)</option>
            <option value="half_even" <%= settings.rounding_rule === 'half_even' ? 'selected' : '' %>>Banker's (89.5 → 90, 88.5 → 88)</option>
            <option value="integer" <%= settings.rounding_rule === 'integer' ? 'selected' : '' %>>Integer only</option>
            <option value="1_decimal" <%= settings.rounding_rule === '1_decimal' ? 'selected' : '' %>>1 decimal (89.5)</option>
            <option value="none" <%= settings.rounding_rule === 'none' ? 'selected' : '' %>>No rounding (raw)</option>
          </select>
        </div>
      </div>
      <button type="submit" class="btn btn-primary"><i class="fa-solid fa-floppy-disk"></i> Save Rules</button>
    </form>
  </div>

  <!-- ============================================ -->
  <!-- CATEGORIES (only if weighted mode) -->
  <!-- ============================================ -->
  <div class="card">
    <h2>Categories &amp; Weights</h2>

    <% if (settings.weighting_mode === 'simple') { %>
      <div class="banner warn">
        <i class="fa-solid fa-circle-info"></i>
        Weighting mode is <strong>Simple sum</strong>. Categories below are ignored.
        Switch to <strong>Weighted</strong> in Calculation Rules to use them.
      </div>
    <% } %>

    <% if (assessments.length === 0) { %>
      <div class="empty">No published assessments in this course yet. Create an assignment or quiz first.</div>
    <% } else { %>

      <% if (settings.weighting_mode === 'weighted') { %>
        <% const tw = totalWeight; %>
        <div class="total-bar <%= Math.abs(tw - 100) < 0.01 ? 'ok' : (tw > 100 ? 'bad' : 'warn') %>">
          <span>
            <% if (Math.abs(tw - 100) < 0.01) { %>
              <i class="fa-solid fa-circle-check"></i> Weights sum to 100% — ready to compute
            <% } else if (tw > 100) { %>
              <i class="fa-solid fa-circle-exclamation"></i> Weights sum to <%= tw.toFixed(2) %>% — exceeds 100%
            <% } else { %>
              <i class="fa-solid fa-triangle-exclamation"></i> Weights sum to <%= tw.toFixed(2) %>% — need exactly 100%
            <% } %>
          </span>
          <span><%= categories.length %> categor<%= categories.length === 1 ? 'y' : 'ies' %></span>
        </div>
      <% } %>

      <form method="POST" action="/course/<%= course.id %>/gradebook/setup/rules/categories" id="catsForm">
        <div id="catsWrap">
          <% categories.forEach((cat, idx) => { %>
            <div class="cat-block" data-cat-idx="<%= idx %>">
              <div class="cat-header">
                <div>
                  <label>Category name</label>
                  <input type="text" name="cats[<%= idx %>][name]" value="<%= cat.name %>" required maxlength="80">
                </div>
                <div>
                  <label>Weight %</label>
                  <input type="number" name="cats[<%= idx %>][weight_pct]" value="<%= cat.weight_pct %>"
                         class="weight-input" min="0" max="100" step="0.5" required>
                </div>
                <div>
                  <label>Drop lowest</label>
                  <input type="number" name="cats[<%= idx %>][drop_lowest_n]" value="<%= cat.drop_lowest_n %>"
                         min="0" step="1">
                </div>
                <div>
                  <label>&nbsp;</label>
                  <button type="button" class="btn btn-danger" onclick="removeCat(this)"><i class="fa-solid fa-trash"></i></button>
                </div>
              </div>

              <div class="cat-items">
                <div class="cat-items-title">Items in this category</div>
                <div class="item-grid">
                  <% assessments.forEach(a => {
                       const key = a.item_type + ':' + a.id;
                       const inThis = cat.items.some(it => it.item_type === a.item_type && it.item_id === a.id);
                  %>
                    <label class="item-check <%= inThis ? 'selected' : '' %>">
                      <input type="checkbox"
                             name="cats[<%= idx %>][item_ids][]"
                             value="<%= key %>"
                             <%= inThis ? 'checked' : '' %>
                             onchange="refreshItemAvailability()">
                      <span class="item-type-badge badge-<%= a.item_type %>"><%= a.item_type === 'assignment' ? 'HW' : 'QZ' %></span>
                      <span style="flex:1;"><%= a.title %></span>
                      <span style="color:var(--muted); font-size:11px;">/<%= a.max_points %></span>
                    </label>
                  <% }); %>
                </div>
              </div>
            </div>
          <% }); %>
        </div>

        <button type="button" class="btn btn-add" onclick="addCat()" style="margin-top:12px;">
          <i class="fa-solid fa-plus"></i> Add category
        </button>

        <div style="margin-top:20px;">
          <button type="submit" class="btn btn-primary"><i class="fa-solid fa-floppy-disk"></i> Save Categories</button>
        </div>
      </form>
    <% } %>
  </div>

  <!-- ============================================ -->
  <!-- UNASSIGNED ITEMS -->
  <!-- ============================================ -->
  <% if (unassigned.length > 0 && settings.weighting_mode === 'weighted') { %>
    <div class="card">
      <h2>Unassigned Items</h2>
      <div class="banner warn">
        <i class="fa-solid fa-triangle-exclamation"></i>
        These published assessments are not in any category and will be <strong>excluded</strong> from the weighted total:
      </div>
      <ul style="padding-left:20px; font-size:14px; line-height:1.8;">
        <% unassigned.forEach(a => { %>
          <li>
            <span class="item-type-badge badge-<%= a.item_type %>"><%= a.item_type === 'assignment' ? 'HW' : 'QZ' %></span>
            <%= a.title %>
            <span style="color:var(--muted);">/ <%= a.max_points %></span>
          </li>
        <% }); %>
      </ul>
    </div>
  <% } %>

</div>

<script>
let nextCatIdx = <%= categories.length %>;

function renumberCats() {
  document.querySelectorAll('.cat-block').forEach((block, i) => {
    block.setAttribute('data-cat-idx', i);
    block.querySelectorAll('input[name^="cats["]').forEach(inp => {
      inp.name = inp.name.replace(/^cats\[\d+\]/, 'cats[' + i + ']');
    });
  });
  nextCatIdx = document.querySelectorAll('.cat-block').length;
  updateTotalWeight();
}

function addCat() {
  const wrap = document.getElementById('catsWrap');
  const idx = nextCatIdx++;
  const block = document.createElement('div');
  block.className = 'cat-block';
  block.setAttribute('data-cat-idx', idx);
  block.innerHTML = `
    <div class="cat-header">
      <div>
        <label>Category name</label>
        <input type="text" name="cats[${idx}][name]" placeholder="e.g. Homework" required maxlength="80">
      </div>
      <div>
        <label>Weight %</label>
        <input type="number" name="cats[${idx}][weight_pct]" value="0" class="weight-input" min="0" max="100" step="0.5" required oninput="updateTotalWeight()">
      </div>
      <div>
        <label>Drop lowest</label>
        <input type="number" name="cats[${idx}][drop_lowest_n]" value="0" min="0" step="1">
      </div>
      <div>
        <label>&nbsp;</label>
        <button type="button" class="btn btn-danger" onclick="removeCat(this)"><i class="fa-solid fa-trash"></i></button>
      </div>
    </div>
    <div class="cat-items">
      <div class="cat-items-title">Items in this category</div>
      <div class="item-grid">
        ${document.getElementById('itemTemplate').innerHTML.replace(/__IDX__/g, idx)}
      </div>
    </div>`;
  wrap.appendChild(block);
  renumberCats();
  refreshItemAvailability();
}

function removeCat(btn) {
  if (!confirm('Remove this category? Its items will become unassigned.')) return;
  btn.closest('.cat-block').remove();
  renumberCats();
  refreshItemAvailability();
}

function updateTotalWeight() {
  let total = 0;
  document.querySelectorAll('.weight-input').forEach(i => {
    total += Number(i.value) || 0;
  });
  const bar = document.querySelector('.total-bar');
  if (!bar) return;
  const diff = Math.abs(total - 100) < 0.01;
  bar.className = 'total-bar ' + (diff ? 'ok' : (total > 100 ? 'bad' : 'warn'));
  bar.querySelector('span').innerHTML = diff
    ? '<i class="fa-solid fa-circle-check"></i> Weights sum to 100% — ready to compute'
    : (total > 100
        ? '<i class="fa-solid fa-circle-exclamation"></i> Weights sum to ' + total.toFixed(2) + '% — exceeds 100%'
        : '<i class="fa-solid fa-triangle-exclamation"></i> Weights sum to ' + total.toFixed(2) + '% — need exactly 100%');
}

function refreshItemAvailability() {
  const checkedValues = new Set();
  document.querySelectorAll('input[name$="[item_ids][]"]:checked').forEach(cb => checkedValues.add(cb.value));
  document.querySelectorAll('input[name$="[item_ids][]"]').forEach(cb => {
    const label = cb.closest('label');
    if (!label) return;
    if (cb.checked) {
      label.classList.remove('disabled');
      cb.disabled = false;
    } else if (checkedValues.has(cb.value)) {
      label.classList.add('disabled');
      cb.disabled = true;
    } else {
      label.classList.remove('disabled');
      cb.disabled = false;
    }
  });
}

document.addEventListener('DOMContentLoaded', () => {
  document.querySelectorAll('.weight-input').forEach(i => i.addEventListener('input', updateTotalWeight));
  refreshItemAvailability();
});

// Hidden template for item checkboxes (used by addCat)
</script>

<script type="text/template" id="itemTemplate">
  <% assessments.forEach(a => { %>
    <label class="item-check">
      <input type="checkbox"
             name="cats[__IDX__][item_ids][]"
             value="<%= a.item_type %>:<%= a.id %>"
             onchange="refreshItemAvailability()">
      <span class="item-type-badge badge-<%= a.item_type %>"><%= a.item_type === 'assignment' ? 'HW' : 'QZ' %></span>
      <span style="flex:1;"><%= a.title %></span>
      <span style="color:var(--muted); font-size:11px;">/<%= a.max_points %></span>
    </label>
  <% }); %>
</script>

</body>
</html>