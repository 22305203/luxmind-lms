<!DOCTYPE html>
<html>
<head>
  <title>LuxMind LMS - Login</title>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
  <style>
    body { font-family: 'DM Sans', sans-serif; background: #f4f6fa; display: flex; justify-content: center; align-items: center; height: 100vh; margin: 0; }
    .card { background: white; padding: 40px; border-radius: 16px; width: 100%; max-width: 380px; text-align: center; box-shadow: 0 8px 28px rgba(24, 39, 75, .08); }
    .logo { width: 50px; height: 50px; background: linear-gradient(135deg, #527df2, #3157cb); border-radius: 12px; color: white; display: flex; align-items: center; justify-content: center; font-size: 24px; margin: 0 auto 20px; }
    h2 { color: #142039; margin: 0 0 8px; font-size: 24px; }
    p { color: #718096; font-size: 13px; margin-bottom: 24px; }
    input { width: 100%; padding: 12px; margin-bottom: 16px; border: 1px solid #dfe5ee; border-radius: 8px; box-sizing: border-box; font-family: inherit; outline: none; }
    input:focus { border-color: #3867e8; }
    button { width: 100%; padding: 12px; background: #111d35; color: white; border: none; border-radius: 8px; font-weight: 700; cursor: pointer; transition: 0.2s; }
    button:hover { background: #1c3155; }
    .error { color: #d34d5b; font-size: 13px; margin-bottom: 16px; background: #fdf2f4; padding: 10px; border-radius: 6px; }
  </style>
</head>
<body>
  <div class="card">
    <div class="logo"><i class="fa-solid fa-book-open"></i></div>
    <h2>LuxMind LMS</h2>
    <p>Log in with your university credentials</p>
    
    <% if (error) { %>
      <div class="error"><%= error %></div>
    <% } %>
    
    <form method="POST" action="/login">
      <input type="text" name="username" placeholder="Username" required>
      <input type="password" name="password" placeholder="Password" required>
      <button type="submit">Log In</button>
    </form>
  </div>
</body>
</html>