<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Scan Attendance | <%= course.code %></title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
  <style>
    body { background: #f4f6fa; display: flex; justify-content: center; align-items: center; height: 100vh; margin: 0; font-family: 'Inter', sans-serif; }
    .card { background: white; padding: 40px; border-radius: 16px; text-align: center; box-shadow: 0 10px 25px rgba(0,0,0,0.05); max-width: 400px; width: 90%; }
    h2 { margin: 16px 0; font-size: 22px; color: #0f172a; }
    p { color: #64748b; font-size: 14px; line-height: 1.5; }
    .icon { font-size: 56px; margin-bottom: 16px; color: #4f46e5; }
    .success { color: #10b981; }
    .error { color: #ef4444; }
    .btn { display: block; width: 100%; padding: 14px; background: #4f46e5; color: white; text-decoration: none; border-radius: 8px; font-weight: 800; font-size: 16px; border: none; cursor: pointer; margin-top: 24px; }
    .btn:hover { background: #4338ca; }
    .btn:disabled { background: #cbd5e1; cursor: not-allowed; }
  </style>
</head>
<body>
  <div class="card">
    
    <div id="initial">
      <i class="fa-solid fa-qrcode icon"></i>
      <h2>Confirm Attendance</h2>
      <p>Are you currently in the classroom for <strong><%= course.title %></strong>?</p>
      <p style="font-size: 12px; margin-top: 8px;">(Your GPS location will be verified)</p>
      <button id="confirmBtn" class="btn" onclick="confirmAttendance()">Confirm My Attendance</button>
    </div>

    <div id="loading" style="display: none;">
      <i class="fa-solid fa-spinner fa-spin icon"></i>
      <h2>Verifying Location...</h2>
      <p>Please wait while we verify you are in the classroom.</p>
    </div>

    <div id="success" style="display: none;">
      <i class="fa-solid fa-circle-check icon success"></i>
      <h2>Attendance Confirmed!</h2>
      <p id="successMsg" style="font-weight: 600; color: #10b981;"></p>
      <p>You can close this window.</p>
      <a href="/course/<%= course.id %>/attendance" class="btn" style="background: #10b981;">View My Attendance</a>
    </div>

    <div id="error" style="display: none;">
      <i class="fa-solid fa-circle-xmark icon error"></i>
      <h2>Rejected</h2>
      <p id="errorMsg" style="font-weight: 600; color: #ef4444;"></p>
      <button onclick="window.location.reload()" class="btn" style="background: #ef4444;">Try Again</button>
    </div>

  </div>

  <script>
const courseId = <%- JSON.stringify(course.id) %>;
const token = <%- JSON.stringify(token) %>;

async function confirmAttendance() {
  const initial = document.getElementById('initial');
  const loading = document.getElementById('loading');
  const success = document.getElementById('success');
  const errorBox = document.getElementById('error');
  const confirmBtn = document.getElementById('confirmBtn');

  // Prevent repeated submissions.
  confirmBtn.disabled = true;

  initial.style.display = 'none';
  errorBox.style.display = 'none';
  success.style.display = 'none';
  loading.style.display = 'block';

  function showError(message) {
    loading.style.display = 'none';
    errorBox.style.display = 'block';
    document.getElementById('errorMsg').textContent =
      message || 'Something went wrong. Please try again.';
    confirmBtn.disabled = false;
  }

  if (!courseId || !token) {
    showError('Invalid course or QR token. Please scan the QR code again.');
    return;
  }

  if (!navigator.geolocation) {
    showError('Your browser does not support GPS location.');
    return;
  }

  navigator.geolocation.getCurrentPosition(
    async (position) => {
      try {
        const response = await fetch(
          `/course/${encodeURIComponent(courseId)}/attendance/scan`,
          {
            method: 'POST',
            credentials: 'same-origin',
            headers: {
              'Content-Type': 'application/json',
              'Accept': 'application/json'
            },
            body: JSON.stringify({
              token,
              lat: position.coords.latitude,
              lng: position.coords.longitude
            })
          }
        );

        const data = await response.json();

        if (!response.ok || !data.success) {
          showError(data.error || 'Attendance could not be confirmed.');
          return;
        }

        loading.style.display = 'none';
        success.style.display = 'block';

        document.getElementById('successMsg').textContent =
          data.message || 'Your attendance has been recorded.';

      } catch (err) {
        console.error('[STUDENT ATTENDANCE ERROR]', err);
        showError(
          'Unable to contact the server. Check your internet connection and try again.'
        );
      }
    },

    (geoError) => {
      let message = 'Unable to get your location.';

      if (geoError.code === 1) {
        message = 'Location permission was denied. Please allow location access.';
      } else if (geoError.code === 2) {
        message = 'Your location is currently unavailable. Please try again.';
      } else if (geoError.code === 3) {
        message = 'Location request timed out. Please try again.';
      }

      showError(message);
    },

    {
      enableHighAccuracy: true,
      timeout: 15000,
      maximumAge: 0
    }
  );
}

  </script>
</body>
</html>