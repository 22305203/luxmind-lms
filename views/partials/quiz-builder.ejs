<!-- ============================================ -->
<!-- HEADER -->
<!-- ============================================ -->
<div style="display:flex; justify-content:space-between; align-items:flex-start; margin-bottom:24px; flex-wrap:wrap; gap:16px;">
  <div>
    <a href="?view=quizzes" style="font-size:13px; font-weight:600; color:var(--primary);">
      <i class="fa-solid fa-arrow-left"></i> Back to Quizzes
    </a>
    <h1 class="section-title" style="margin-top:8px;"><%= activeQuiz.title %></h1>
    <p style="color:var(--text-muted); font-size:13px; margin-top:4px;">
      <%= activeQuizQuestions.length %> questions · <%= activeQuiz.total_marks %> marks ·
      <span style="padding:2px 8px; border-radius:4px; background:<%= activeQuiz.is_published ? 'rgba(16,185,129,0.15)' : 'rgba(239,68,68,0.15)' %>; color:<%= activeQuiz.is_published ? '#10b981' : '#ef4444' %>; font-weight:700;">
        <%= activeQuiz.is_published ? 'PUBLISHED' : 'DRAFT' %>
      </span>
    </p>
  </div>
  <div style="display:flex; gap:8px; flex-wrap:wrap;">
    <form action="/course/<%= course.id %>/quizzes/<%= activeQuiz.id %>/publish" method="POST" style="display:inline;">
      <button type="submit" class="btn" style="background:<%= activeQuiz.is_published ? '#f59e0b' : '#10b981' %>;">
        <i class="fa-solid <%= activeQuiz.is_published ? 'fa-eye-slash' : 'fa-eye' %>"></i>
        <%= activeQuiz.is_published ? 'Unpublish' : 'Publish' %>
      </button>
    </form>
    <a href="/course/<%= course.id %>/quizzes/<%= activeQuiz.id %>/grading" class="btn btn-outline">
      <i class="fa-solid fa-check-double"></i> Grade
    </a>
    <form action="/course/<%= course.id %>/quizzes/<%= activeQuiz.id %>/delete" method="POST"
          onsubmit="return confirm('Delete this quiz permanently?');" style="display:inline;">
      <button type="submit" class="btn" style="background:#ef4444;"><i class="fa-solid fa-trash"></i></button>
    </form>
  </div>
</div>

<!-- ============================================ -->
<!-- SETTINGS FORM -->
<!-- ============================================ -->
<form action="/course/<%= course.id %>/quizzes/<%= activeQuiz.id %>" method="POST"
      style="background:var(--bg-surface); border:1px solid var(--border); border-radius:16px; padding:28px; margin-bottom:32px;">
  <h3 style="margin-bottom:20px; color:var(--primary);"><i class="fa-solid fa-gear"></i> Quiz Settings</h3>

  <div style="display:grid; grid-template-columns:2fr 1fr 1fr; gap:16px; margin-bottom:16px;">
    <input type="text" name="title" class="form-input" value="<%= activeQuiz.title %>" required>
    <input type="number" name="duration_minutes" class="form-input" min="1" value="<%= activeQuiz.duration_minutes %>" required>
    <input type="number" name="max_attempts" class="form-input" min="1" value="<%= activeQuiz.max_attempts %>">
  </div>

  <textarea name="description" class="form-input" rows="2" placeholder="Description" style="margin-bottom:16px;"><%= activeQuiz.description || '' %></textarea>
  <textarea name="instructions" class="form-input" rows="2" placeholder="Instructions shown before start" style="margin-bottom:16px;"><%= activeQuiz.instructions || '' %></textarea>

  <div style="display:grid; grid-template-columns:1fr 1fr 1fr 1fr; gap:16px; margin-bottom:16px;">
    <label style="font-size:12px; font-weight:600; color:var(--text-muted);">Opens
      <input type="datetime-local" name="open_at" class="form-input" style="margin-top:4px;"
             value="<%= activeQuiz.open_at ? new Date(activeQuiz.open_at).toISOString().slice(0,16) : '' %>">
    </label>
    <label style="font-size:12px; font-weight:600; color:var(--text-muted);">Closes
      <input type="datetime-local" name="close_at" class="form-input" style="margin-top:4px;"
             value="<%= activeQuiz.close_at ? new Date(activeQuiz.close_at).toISOString().slice(0,16) : '' %>">
    </label>
    <label style="font-size:12px; font-weight:600; color:var(--text-muted);">Grades Released
      <input type="datetime-local" name="grade_release_at" class="form-input" style="margin-top:4px;"
             value="<%= activeQuiz.grade_release_at ? new Date(activeQuiz.grade_release_at).toISOString().slice(0,16) : '' %>">
    </label>
    <label style="font-size:12px; font-weight:600; color:var(--text-muted);">Pass Mark
      <input type="number" name="pass_mark" class="form-input" min="0" style="margin-top:4px;"
             value="<%= activeQuiz.pass_mark != null ? activeQuiz.pass_mark : '' %>">
    </label>
  </div>

  <div style="display:grid; grid-template-columns:1fr 1fr; gap:16px; margin-bottom:16px;">
    <label style="font-size:12px; font-weight:600; color:var(--text-muted);">Late start
      <select name="late_start_behavior" class="form-input" style="margin-top:4px;">
        <option value="truncated" <%= activeQuiz.late_start_behavior === 'truncated' ? 'selected' : '' %>>Truncate to close time</option>
        <option value="full" <%= activeQuiz.late_start_behavior === 'full' ? 'selected' : '' %>>Full duration</option>
        <option value="blocked" <%= activeQuiz.late_start_behavior === 'blocked' ? 'selected' : '' %>>Block late starts</option>
      </select>
    </label>
    <label style="font-size:12px; font-weight:600; color:var(--text-muted);">Warnings before auto-submit
      <input type="number" name="auto_submit_after_warnings" class="form-input" min="1" style="margin-top:4px;"
             value="<%= activeQuiz.auto_submit_after_warnings %>">
    </label>
  </div>

  <div style="display:flex; flex-wrap:wrap; gap:20px; margin-bottom:20px; font-size:13px;">
    <label><input type="checkbox" name="duration_fixed" <%= activeQuiz.duration_fixed ? 'checked' : '' %>> Fixed duration</label>
    <label><input type="checkbox" name="shuffle_questions" <%= activeQuiz.shuffle_questions ? 'checked' : '' %>> Shuffle questions</label>
    <label><input type="checkbox" name="shuffle_choices" <%= activeQuiz.shuffle_choices ? 'checked' : '' %>> Shuffle choices</label>
    <label><input type="checkbox" name="anti_cheat_enabled" <%= activeQuiz.anti_cheat_enabled ? 'checked' : '' %>> Anti-cheat</label>
    <label><input type="checkbox" name="show_correct_answers" <%= activeQuiz.show_correct_answers ? 'checked' : '' %>> Show answers</label>
    <label><input type="checkbox" name="show_feedback" <%= activeQuiz.show_feedback ? 'checked' : '' %>> Show feedback</label>
  </div>

  <button type="submit" class="btn"><i class="fa-solid fa-floppy-disk"></i> Save Settings</button>
</form>

<!-- ============================================ -->
<!-- EXISTING QUESTIONS -->
<!-- ============================================ -->
<h3 style="margin-bottom:16px; color:var(--text-main);"><i class="fa-solid fa-list-ol"></i> Questions (<%= activeQuizQuestions.length %>)</h3>

<% if (activeQuizQuestions.length === 0) { %>
  <div style="padding:32px; text-align:center; background:var(--bg-surface); border-radius:12px; border:1px dashed var(--border); color:var(--text-muted); margin-bottom:32px;">
    No questions yet. Add one below.
  </div>
<% } else { %>
  <div style="margin-bottom:32px;">
    <% activeQuizQuestions.forEach((q, idx) => { %>
      <div style="background:var(--bg-surface); border:1px solid var(--border); border-radius:12px; padding:20px; margin-bottom:12px;">
        <div style="display:flex; justify-content:space-between; align-items:flex-start; gap:12px;">
          <div style="flex:1;">
            <div style="display:flex; gap:8px; align-items:center; margin-bottom:8px;">
              <span style="background:var(--primary-soft); color:var(--primary); padding:3px 10px; border-radius:6px; font-size:11px; font-weight:800;">Q<%= idx + 1 %></span>
              <span style="background:var(--bg-body); color:var(--text-muted); padding:3px 10px; border-radius:6px; font-size:11px; font-weight:700;"><%= q.type %></span>
              <span style="color:var(--text-muted); font-size:11px;"><%= q.marks %> mark<%= q.marks === 1 ? '' : 's' %></span>
              <% if (!q.auto_grade) { %><span style="color:#f59e0b; font-size:11px; font-weight:700;">· manual grade</span><% } %>
            </div>
            <p style="font-weight:600; margin-bottom:8px;"><%= q.prompt %></p>

            <% if (q.type === 'MCQ' || q.type === 'TF') { %>
              <% activeQuizChoices.filter(c => c.question_id === q.id).forEach(c => { %>
                <div style="font-size:13px; padding:4px 0; color:<%= c.is_correct ? '#10b981' : 'var(--text-muted)' %>;">
                  <i class="fa-solid <%= c.is_correct ? 'fa-circle-check' : 'fa-circle' %>"></i> <%= c.text %>
                </div>
              <% }); %>
            <% } else if (q.type === 'FILL_BLANK') { %>
              <div style="font-size:13px; color:#10b981;">
                <i class="fa-solid fa-circle-check"></i> <%= q.correct_answer?.value || '(none)' %>
                <% if (q.correct_answer?.synonyms?.length) { %>
                  <span style="color:var(--text-muted);"> · synonyms: <%= q.correct_answer.synonyms.join(', ') %></span>
                <% } %>
              </div>
            <% } else if (q.correct_answer?.model_answer) { %>
              <div style="font-size:13px; color:var(--text-muted); margin-top:6px; padding:8px; background:var(--bg-body); border-radius:6px;">
                <strong>Model answer:</strong> <%= q.correct_answer.model_answer %>
              </div>
            <% } %>

            <% if (q.explanation) { %>
              <div style="font-size:12px; color:var(--text-muted); margin-top:8px;">
                <i class="fa-solid fa-lightbulb"></i> <%= q.explanation %>
              </div>
            <% } %>
          </div>
          <form action="/course/<%= course.id %>/quizzes/<%= activeQuiz.id %>/questions/<%= q.id %>/delete" method="POST"
                onsubmit="return confirm('Delete this question?');">
            <button type="submit" class="btn" style="background:#ef4444; padding:6px 10px;"><i class="fa-solid fa-trash"></i></button>
          </form>
        </div>
      </div>
    <% }); %>
  </div>
<% } %>

<!-- ============================================ -->
<!-- ADD QUESTION FORM -->
<!-- ============================================ -->
<form action="/course/<%= course.id %>/quizzes/<%= activeQuiz.id %>/questions" method="POST"
      style="background:var(--bg-surface); border:2px dashed var(--primary); border-radius:16px; padding:28px;">
  <h3 style="margin-bottom:20px; color:var(--primary);"><i class="fa-solid fa-circle-plus"></i> Add Question</h3>

  <div style="display:grid; grid-template-columns:1fr 140px 100px; gap:16px; margin-bottom:16px;">
    <select name="type" id="qType" class="form-input" onchange="toggleQFields(this.value)">
      <option value="MCQ">Multiple Choice (MCQ)</option>
      <option value="TF">True / False</option>
      <option value="FILL_BLANK">Fill in the Blank</option>
      <option value="SHORT_ANSWER">Short Answer</option>
      <option value="ESSAY">Essay</option>
    </select>
    <input type="number" name="marks" class="form-input" min="0" value="1" placeholder="Marks">
    <label style="display:flex; align-items:center; gap:8px; font-size:13px; font-weight:600;">
      <input type="checkbox" name="auto_grade" id="autoGrade"> Auto-grade
    </label>
  </div>

  <textarea name="prompt" class="form-input" rows="2" placeholder="Question prompt" required style="margin-bottom:16px;"></textarea>

  <!-- ---------- MCQ ---------- -->
  <div id="fields-MCQ" style="margin-bottom:16px;">
    <div id="mcqChoices">
      <div class="choice-row" style="display:grid; grid-template-columns:1fr 100px 40px; gap:8px; margin-bottom:8px;">
        <input type="text" name="choice_texts[]" class="form-input" placeholder="Choice A">
        <label style="display:flex; align-items:center; gap:6px; font-size:12px; font-weight:600;">
          <input type="checkbox" name="choice_correct[]" value="0"> Correct
        </label>
        <button type="button" onclick="this.parentElement.remove()" class="btn" style="background:#ef4444; padding:6px;"><i class="fa-solid fa-xmark"></i></button>
      </div>
      <div class="choice-row" style="display:grid; grid-template-columns:1fr 100px 40px; gap:8px; margin-bottom:8px;">
        <input type="text" name="choice_texts[]" class="form-input" placeholder="Choice B">
        <label style="display:flex; align-items:center; gap:6px; font-size:12px; font-weight:600;">
          <input type="checkbox" name="choice_correct[]" value="1"> Correct
        </label>
        <button type="button" onclick="this.parentElement.remove()" class="btn" style="background:#ef4444; padding:6px;"><i class="fa-solid fa-xmark"></i></button>
      </div>
    </div>
    <button type="button" class="btn btn-outline" onclick="addChoice()" style="margin-top:8px;">
      <i class="fa-solid fa-plus"></i> Add choice
    </button>
  </div>

  <!-- ---------- TF ---------- -->
  <div id="fields-TF" style="display:none; margin-bottom:16px;">
    <label style="font-size:12px; font-weight:600; color:var(--text-muted);">Correct value
      <select name="tf_value" class="form-input" style="margin-top:4px;">
        <option value="true">True</option>
        <option value="false">False</option>
      </select>
    </label>
  </div>

  <!-- ---------- FILL_BLANK ---------- -->
  <div id="fields-FILL_BLANK" style="display:none; margin-bottom:16px;">
    <input type="text" name="fill_value" class="form-input" placeholder="Correct answer" style="margin-bottom:8px;">
    <input type="text" name="synonyms" class="form-input" placeholder="Synonyms (comma separated, optional)" style="margin-bottom:8px;">
    <div style="display:grid; grid-template-columns:1fr 1fr; gap:8px;">
      <input type="number" name="tolerance" class="form-input" step="0.0001" placeholder="Numeric tolerance (optional)">
      <label style="display:flex; align-items:center; gap:8px; font-size:13px;">
        <input type="checkbox" name="case_insensitive" checked> Case-insensitive
      </label>
    </div>
  </div>

  <!-- ---------- SHORT_ANSWER / ESSAY ---------- -->
  <div id="fields-TEXT" style="display:none; margin-bottom:16px;">
    <textarea name="model_answer" class="form-input" rows="3" placeholder="Model answer (optional — used for auto-grading and shown as reference)"></textarea>
  </div>

  <textarea name="explanation" class="form-input" rows="2" placeholder="Explanation shown to students after grading (optional)" style="margin-bottom:16px;"></textarea>

  <button type="submit" class="btn"><i class="fa-solid fa-plus"></i> Add Question</button>
</form>

<script>
function toggleQFields(type) {
  ['MCQ','TF','FILL_BLANK','TEXT'].forEach(id => {
    const el = document.getElementById('fields-' + id);
    if (el) el.style.display = 'none';
  });
  const map = { MCQ: 'MCQ', TF: 'TF', FILL_BLANK: 'FILL_BLANK', SHORT_ANSWER: 'TEXT', ESSAY: 'TEXT' };
  const target = document.getElementById('fields-' + map[type]);
  if (target) target.style.display = 'block';

  // Auto-grade checkbox: ON for MCQ/TF/FILL_BLANK, OFF for SHORT/ESSAY
  const ag = document.getElementById('autoGrade');
  if (ag) ag.checked = ['MCQ','TF','FILL_BLANK'].includes(type);

  // Re-number choice indices after dynamic add/remove
  renumberChoices();
}

function addChoice() {
  const wrap = document.getElementById('mcqChoices');
  const idx = wrap.children.length;
  const row = document.createElement('div');
  row.className = 'choice-row';
  row.style.cssText = 'display:grid; grid-template-columns:1fr 100px 40px; gap:8px; margin-bottom:8px;';
  row.innerHTML = `
    <input type="text" name="choice_texts[]" class="form-input" placeholder="Choice ${String.fromCharCode(65+idx)}">
    <label style="display:flex; align-items:center; gap:6px; font-size:12px; font-weight:600;">
      <input type="checkbox" name="choice_correct[]" value="${idx}"> Correct
    </label>
    <button type="button" onclick="this.parentElement.remove(); renumberChoices();" class="btn" style="background:#ef4444; padding:6px;"><i class="fa-solid fa-xmark"></i></button>`;
  wrap.appendChild(row);
  renumberChoices();
}

function renumberChoices() {
  const wrap = document.getElementById('mcqChoices');
  if (!wrap) return;
  Array.from(wrap.children).forEach((row, i) => {
    const cb = row.querySelector('input[type=checkbox]');
    if (cb) cb.value = i;
    const inp = row.querySelector('input[type=text]');
    if (inp && !inp.value) inp.placeholder = 'Choice ' + String.fromCharCode(65 + i);
  });
}

// Init on page load
toggleQFields(document.getElementById('qType').value);
</script>