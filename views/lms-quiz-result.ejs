<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= quiz.title %> — Result</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
  <style>
    body { font-family: 'Inter', sans-serif; background:#f4f6fa; color:#0f172a; padding:32px; }
    .shell { max-width: 820px; margin: 0 auto; }
    .card { background:#fff; border:1px solid #e2e8f0; border-radius:16px; padding:28px; margin-bottom:20px; }
    .score { font: 800 32px sans-serif; color:#4f46e5; margin-top:8px; }
    .q { border-bottom:1px solid #e2e8f0; padding:18px 0; }
    .q:last-child { border-bottom:none; }
    .ok { color:#10b981; font-weight:600; }
    .bad { color:#ef4444; font-weight:600; }
    .muted { color:#64748b; font-size:13px; margin:4px 0; }
    h1 { margin-bottom:8px; }
  </style>
</head>
<body>
<div class="shell">
  <div class="card">
    <h1><%= quiz.title %></h1>
    <p class="muted">Attempt status: <strong><%= attempt.status %></strong></p>
    <% if (isReleased) { %>
      <div class="score"><%= Number(attempt.total_score).toFixed(1) %> / <%= quiz.total_marks %></div>
      <p class="muted"><%= Number(attempt.percentage).toFixed(1) %>%</p>
    <% } else { %>
      <p style="margin-top:16px; padding:14px; background:#fef3c7; border-radius:10px;">
        Grading in progress. Results available on
        <strong><%= quiz.grade_release_at ? new Date(quiz.grade_release_at).toLocaleString() : 'a later date' %></strong>.
      </p>
    <% } %>
  </div>

  <% if (isReleased) { %>
    <div class="card">
      <h2 style="margin-bottom:16px;">Question breakdown</h2>
      <% breakdown.forEach((b, i) => { %>
        <div class="q">
          <p style="font-weight:600; margin-bottom:8px;">Q<%= i+1 %>. <%= b.question.prompt %></p>
          <p class="muted">Your answer: <span class="<%= b.isCorrect ? 'ok' : 'bad' %>"><%= b.yourAnswerText || '(blank)' %></span></p>
          <% if (b.correctAnswerText) { %>
            <p class="muted">Correct answer: <span class="ok"><%= b.correctAnswerText %></span></p>
          <% } %>
          <p class="muted">Marks: <strong><%= b.marksEarned %> / <%= b.maxMarks %></strong></p>
          <% if (b.feedback) { %><p class="muted">Teacher feedback: <%= b.feedback %></p><% } %>
          <% if (b.explanation) { %><p class="muted">Explanation: <%= b.explanation %></p><% } %>
        </div>
      <% }); %>
    </div>
  <% } %>

  <p><a href="/course/<%= course.id %>?view=quizzes">← Back to quizzes</a></p>
</div>
</body>
</html>